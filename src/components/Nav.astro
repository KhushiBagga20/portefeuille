---
import Seal from './Seal.astro';
import SoundToggle from './SoundToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { chapters } from '../data/chapters';
import { site } from '../data/site';

interface Props {
  /** what the "you are here" slot says on pages that aren't the home page */
  here?: string;
}
const { here } = Astro.props;

const numbered = site.nav.map((item) => {
  const i = chapters.findIndex((c) => `/#${c.id}` === item.href);
  return { ...item, index: i < 0 ? '' : String(i).padStart(2, '0') };
});
---

<header class="nav s-paper">
  <a class="nav__mark" href="/#top" aria-label={`${site.name}, home`}>
    <span class="nav__seal"><Seal /></span>
    <span class="nav__name">{site.name}</span>
  </a>

  <p class="nav__now" aria-hidden="true">
    {
      here ? (
        <span>{here}</span>
      ) : (
        <Fragment>
          <span data-chapter-idx>(00)</span>
          <span data-chapter-now>{chapters[0].name}</span>
        </Fragment>
      )
    }
  </p>

  <nav class="nav__links" aria-label="Main">
    {numbered.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="nav__tools">
    <ThemeToggle />
    <SoundToggle />
    <button class="nav__menu" type="button" popovertarget="site-menu" aria-label="Open menu">
      <span aria-hidden="true"></span>menu
    </button>
  </div>

  <nav id="site-menu" class="menu s-ink" popover aria-label="Main (mobile)">
    <ul>
      {
        numbered.map((item) => (
          <li>
            <a href={item.href}>
              <span class="menu__idx">{item.index && `(${item.index})`}</span>
              <span class="menu__name">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const menu = document.getElementById('site-menu');
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) (menu as HTMLElement & { hidePopover(): void }).hidePopover();
  });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 34px);
    height: var(--bar);
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--line);
    background-color: var(--bg);
    color: var(--fg);
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-display);
    font-size: 21px;
    font-stretch: 112%;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav__seal {
    width: 22px;
    transition: rotate 0.9s var(--spring);
  }

  .nav__mark:hover .nav__seal {
    rotate: 120deg;
  }

  .nav__now {
    display: flex;
    gap: 8px;
    margin: 0;
    color: var(--fg-2);
    font: 600 semi-expanded 11px/1 var(--font-label);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    gap: clamp(14px, 2vw, 28px);
    margin-left: auto;
  }

  .nav__links a {
    position: relative;
    padding: 8px 0;
    font: 600 semi-expanded 11px/1 var(--font-label);
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav__links a::after {
    content: '';
    position: absolute;
    inset: auto 0 2px;
    height: 1.5px;
    background: currentColor;
    scale: 0 1;
    transform-origin: right;
    transition: scale 0.3s var(--ease-out);
  }

  .nav__links a:hover::after,
  .nav__links a[aria-current]::after {
    scale: 1 1;
    transform-origin: left;
  }

  .nav__tools {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav__menu {
    display: none;
    align-items: center;
    gap: 8px;
    height: 36px;
    margin-left: 6px;
    padding: 0 14px;
    border: 1.5px solid var(--fg);
    border-radius: 999px;
    background: none;
    font: 600 semi-expanded 11px/1 var(--font-label);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .nav__menu span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  /* ── the phone menu: a dark sheet with the running order set large ── */
  .menu {
    inset: var(--bar) 0 auto 0;
    width: 100%;
    max-width: none;
    max-height: calc(100svh - var(--bar));
    margin: 0;
    padding: 18px var(--gutter) 28px;
    border: 0;
    background: var(--bg);
    color: var(--fg);
    overflow-y: auto;
  }

  .menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 10px 0 8px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .menu__idx {
    width: 4ch;
    color: var(--accent);
    font: 600 semi-expanded 11px/1 var(--font-label);
    letter-spacing: 0.09em;
  }

  .menu__name {
    font-family: var(--font-display);
    font-size: clamp(44px, 15vw, 88px);
    font-stretch: 66%;
    font-weight: 800;
    line-height: 0.92;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu:popover-open {
      animation: menu-in 0.42s var(--ease-out);
    }

    @keyframes menu-in {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }

  @media (max-width: 899px) {
    .nav__links {
      display: none;
    }

    .nav__tools {
      margin-left: auto;
    }

    .nav__menu {
      display: inline-flex;
    }
  }

  @media (max-width: 479px) {
    .nav__now {
      display: none;
    }
  }
</style>
