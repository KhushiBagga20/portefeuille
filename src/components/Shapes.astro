---
// A flat-shape layer that sits behind a section: rings, leaves, blobs, dot grids
// and checker blocks in green, teal and sea blue.
//
// Purely decorative — hidden from screen readers, never catches a click, and always
// painted under the content. Shapes are placed toward the edges so the reading column
// stays clean; `hide` drops the busiest ones on narrow screens.
type Kind = 'disc' | 'ring' | 'rings' | 'blob' | 'leaf' | 'petal' | 'arc' | 'pill' | 'dots' | 'checker' | 'gear' | 'bolt' | 'pipe';

/** A cog with flat-topped teeth and a hole through the hub. */
function gearPath(teeth = 11, ro = 49, ri = 37, hub = 15) {
  const pts: string[] = [];
  const at = (r: number, a: number) => pts.push(`${(50 + r * Math.cos(a)).toFixed(2)} ${(50 + r * Math.sin(a)).toFixed(2)}`);
  const w = (Math.PI * 2) / teeth;
  for (let i = 0; i < teeth; i++) {
    const a = i * w;
    at(ro, a + w * 0.06);
    at(ro, a + w * 0.38);
    at(ri, a + w * 0.47);
    at(ri, a + w * 0.94);
  }
  // second subpath is the hub hole (fill-rule: evenodd punches it out)
  return `M${pts.join('L')}Z M${50 + hub} 50 A${hub} ${hub} 0 1 0 ${50 - hub} 50 A${hub} ${hub} 0 1 0 ${50 + hub} 50Z`;
}
const GEAR = gearPath();

type Shape = {
  k: Kind;
  /** position, in % of the section box */
  x: number;
  y: number;
  /** size, as a multiple of the base unit */
  s: number;
  c: string;
  rot?: number;
  o?: number;
  /** drop this one on narrow screens */
  hide?: boolean;
};

interface Props {
  variant: 'about' | 'projects' | 'milestones' | 'communities' | 'skills' | 'contact';
}

const { variant } = Astro.props;

