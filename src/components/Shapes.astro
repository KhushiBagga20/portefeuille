const shapes = sets[variant];
---

<div class="shapes" aria-hidden="true">
  <span class="stars"></span>
  {
    shapes.map((p) => (
      <span
        class:list={['s', `s--${p.k}`, p.hide && 'is-extra']}
        style={`--x:${p.x}%;--y:${p.y}%;--s:${p.s};--c:${p.c};--rot:${p.rot ?? 0}deg;--o:${p.o ?? 1}`}
      >
        {p.k === 'gear' && (
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <path d={GEAR} fill-rule="evenodd" />
          </svg>
        )}
      </span>
    ))
  }
</div>

<style>
  .shapes {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* The castle's night sky. Nothing to see while the sun is up. */
  .stars {
    position: absolute;
    inset: 0;
    opacity: 0;
    background-image:
      radial-gradient(1.6px 1.6px at 12% 18%, var(--bone), transparent),
      radial-gradient(1.4px 1.4px at 68% 9%, var(--bone), transparent),
      radial-gradient(1.8px 1.8px at 34% 62%, var(--bone), transparent),
      radial-gradient(1.3px 1.3px at 88% 44%, var(--bone), transparent),
      radial-gradient(1.5px 1.5px at 54% 86%, var(--bone), transparent),
      radial-gradient(1.2px 1.2px at 22% 92%, var(--bone), transparent),
      radial-gradient(1.7px 1.7px at 78% 73%, var(--bone), transparent),
      radial-gradient(1.3px 1.3px at 44% 32%, var(--bone), transparent);
    transition: opacity 0.6s ease;
  }

  :global(:root[data-theme='night']) .stars {
    opacity: 0.75;
    animation: twinkle 6s ease-in-out infinite alternate;
  }

  @keyframes twinkle {
    to {
      opacity: 0.4;
    }
  }

  .s {
    --u: clamp(64px, 9vw, 132px);
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(var(--u) * var(--s));
    height: calc(var(--u) * var(--s));
    opacity: var(--o);
    rotate: var(--rot);
    translate: -50% -50%;
  }

  /* ── the vocabulary ──────────────────── */
  .s--disc {
    border-radius: 50%;
    background: var(--c);
  }

  .s--ring {
    border: calc(var(--u) * 0.13) solid var(--c);
    border-radius: 50%;
  }

  /* concentric circles, like the painting's eyes */
  .s--rings {
    border-radius: 50%;
    background: var(--c);
    box-shadow:
      0 0 0 calc(var(--u) * 0.1) var(--paper),
      0 0 0 calc(var(--u) * 0.2) var(--c),
      0 0 0 calc(var(--u) * 0.3) var(--paper),
      0 0 0 calc(var(--u) * 0.36) var(--c);
    scale: 0.42;
  }

  .s--blob {
    border-radius: 58% 42% 37% 63% / 46% 58% 42% 54%;
    background: var(--c);
  }

  .s--leaf {
    border-radius: 0 100% 0 100%;
    background: var(--c);
  }

  .s--petal {
    border-radius: 100% 0 100% 0;
    background: var(--c);
  }

  /* a half-disc, flat side down */
  .s--arc {
    height: calc(var(--u) * var(--s) * 0.5);
    border-radius: 999px 999px 0 0;
    background: var(--c);
  }

  .s--pill {
    width: calc(var(--u) * var(--s) * 1.6);
    height: calc(var(--u) * var(--s) * 0.42);
    border-radius: 999px;
    background: var(--c);
  }

  .s--dots {
    color: var(--c);
    background-image: radial-gradient(currentColor 26%, transparent 28%);
    background-size: calc(var(--u) * 0.2) calc(var(--u) * 0.2);
  }

  /* ── the machine parts ───────────────── */
  .s--gear svg {
    width: 100%;
    height: 100%;
    fill: var(--c);
  }

  .s--gear {
    animation: turn 34s linear infinite;
  }

  .s--gear:nth-of-type(even) {
    animation-direction: reverse;
  }

  @keyframes turn {
    to {
      rotate: 360deg;
    }
  }

  .s--bolt {
    background: var(--c);
    clip-path: polygon(25% 2%, 75% 2%, 100% 50%, 75% 98%, 25% 98%, 0 50%);
  }

  .s--bolt::after {
    content: '';
    position: absolute;
    inset: 42% 22%;
    border-radius: 2px;
    background: var(--paper);
    opacity: 0.55;
  }

  /* an elbow of pipe, for joining one room to the next */
  .s--pipe {
    border: calc(var(--u) * 0.17) solid var(--c);
    border-top-color: transparent;
    border-right-color: transparent;
    border-bottom-left-radius: 100%;
    background: none;
  }

  /* a nod to the grid in the poster */
  .s--checker {
    background:
      conic-gradient(var(--c) 0 25%, transparent 0 50%) 0 0 / calc(var(--u) * 0.34) calc(var(--u) * 0.34);
  }

  /* On phones the content runs edge to edge, so the shapes shrink, the busiest
     ones step out, and the whole layer sits back a little. */
  @media (max-width: 700px) {
    .shapes {
      opacity: 0.8;
    }

    .s {
      --u: clamp(48px, 15vw, 90px);
    }

    .is-extra {
      display: none;
    }
  }
</style>

<style>
  @media (prefers-reduced-motion: reduce) {
    .s--gear,
    .stars {
      animation: none;
    }
  }
</style>
