---
// A string of marigolds hung across the top of a section, the way a toran hangs
// over a doorway. Drawn, not photographed — ruffled petals, ink outline, and a
// slow sway so the whole thing breathes.
//
// Purely decorative: hidden from screen readers and never catches a click.

interface Props {
  /** how far the string droops, in viewBox units */
  droop?: number;
  /** how many flowers along it */
  count?: number;
  class?: string;
}

const { droop = 62, count = 11, class: className } = Astro.props;

const W = 1400;
const Y0 = 24; // room above the string so the flower tops aren't clipped

// A quadratic through (0,Y0) → (W/2, Y0+droop) → (W,Y0): the sag of a hung string.
const at = (t: number) => {
  const x = t * W;
  const y = Y0 + 4 * droop * t * (1 - t);
  return [x, y] as const;
};

// Flower sizes alternate a little so the string doesn't look machine-made.
const beads = Array.from({ length: count }, (_, i) => {
  const t = (i + 0.5) / count;
  const [x, y] = at(t);
  const wobble = [1, 0.82, 0.93, 0.76, 0.88][i % 5];
  const r = 27 * wobble;
  return { x, y: y + r * 0.78, r, rot: ((i * 53) % 40) - 20, delay: (i % 5) * 0.4 };
});

// leaves tucked between the flowers
const leaves = Array.from({ length: count - 1 }, (_, i) => {
  const t = (i + 1) / count;
  const [x, y] = at(t);
  return { x, y: y + 9, flip: i % 2 === 0 };
});

const path = `M0 ${Y0} Q${W / 2} ${Y0 + droop * 2} ${W} ${Y0}`;

// one marigold: a deep base, a ring of petals, a brighter heart
const petals = (n: number, radius: number, r: number) =>
  Array.from({ length: n }, (_, i) => {
    const a = (i / n) * Math.PI * 2;
    return { cx: Math.cos(a) * radius, cy: Math.sin(a) * radius, r };
  });
const outer = petals(11, 16, 9.5);
const inner = petals(7, 8, 7);
---

<svg class:list={['garland', className]} viewBox={`0 0 ${W} ${Y0 + droop + 56}`} aria-hidden="true" focusable="false">
  <path class="garland__string" d={path}></path>
  {
    leaves.map((l) => (
      <ellipse
        class="garland__leaf"
        cx={l.x}
        cy={l.y}
        rx="15"
        ry="8"
        transform={`rotate(${l.flip ? 28 : -28} ${l.x} ${l.y})`}
      />
    ))
  }
  {
    beads.map((b) => (
      <g class="garland__bead" style={`--d:${b.delay}s`} transform={`translate(${b.x} ${b.y})`}>
        <g transform={`rotate(${b.rot}) scale(${b.r / 26})`}>
          <circle class="garland__base" r="25" />
          {outer.map((p) => <circle class="garland__petal" cx={p.cx} cy={p.cy} r={p.r} />)}
          {inner.map((p) => <circle class="garland__heart" cx={p.cx} cy={p.cy} r={p.r} />)}
          <circle class="garland__eye" r="4.5" />
        </g>
      </g>
    ))
  }
</svg>

<style>
  .garland {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    pointer-events: none;
  }

  .garland__string {
    fill: none;
    stroke: var(--leaf-deep);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .garland__leaf {
    fill: var(--leaf);
    stroke: var(--ink);
    stroke-width: 3;
  }

  .garland__base {
    fill: var(--marigold-deep);
    stroke: var(--ink);
    stroke-width: 3.5;
  }

  .garland__petal {
    fill: var(--marigold);
  }

  .garland__heart {
    fill: var(--turmeric);
  }

  .garland__eye {
    fill: var(--marigold-deep);
  }

  /* each flower swings a touch out of step with its neighbours */
  .garland__bead {
    transform-box: fill-box;
    transform-origin: center -22px;
    animation: swing 5.5s ease-in-out infinite alternate;
    animation-delay: var(--d);
  }

  @keyframes swing {
    from {
      rotate: -3deg;
    }
    to {
      rotate: 3deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .garland__bead {
      animation: none;
    }
  }
</style>
