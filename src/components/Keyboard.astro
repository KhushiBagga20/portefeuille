---
// The keyboard, shown as the site's one big object: a cobalt room, the board floating in
// it, and a wall of type behind that repeats whatever you press.
//
// It is the gateway to both halves of the site: bright keys jump around this page, dark
// keys open rooms of the Playground (the list is src/data/keyboard.ts).
//
// The board itself (KeyboardScene, Garden, scripts/keyboard.ts) is unchanged.
import KeyboardScene from './KeyboardScene.astro';
import PosterHead from './PosterHead.astro';
import { chapter } from '../data/chapters';
import { desk, pad, pageKeys, playKeys } from '../data/keyboard';
import { basis, project } from '../scripts/iso';
import { KEY } from '../scripts/keycap';

const c = chapter('keyboard');
const IDLE = 'press any key';

// Where the board's highest key sits in its own drawing, so the stylesheet can place the
// whole board just below the strip at any window shape. The drawing is scaled to cover its
// stage (width-fitted on wide windows, height-fitted on tall ones), so the key's position on
// screen is one of two things; the CSS takes whichever applies.
const m = basis(desk.camera);
const [boxW, boxH] = desk.viewBox;
const highest = Math.min(
  ...desk.keys.filter((k) => !k.hole).flatMap((k) => [-1, 1].map((side) => project(m, k.cx + side * k.w * 50, k.cy - 50, KEY.rest)[1])),
);
const stage = `--key-tall:${(highest / boxH).toFixed(4)};--key-wide:${(((boxH / 2 - highest) / boxW) * 100).toFixed(2)}vw`;
---

<section id="keyboard" class="keyboard poster s-cobalt" style={stage} {...c.attrs} aria-labelledby="keyboard-title">
  <!-- behind the board: the idle line, or your own typing -->
  <div class="wall" data-wall aria-hidden="true">
    <span class="wall__idle" style={`--n:${IDLE.length}`}>{IDLE}</span>
    <span class="wall__live" data-wall-text></span>
  </div>

  <div class="scene">
    <KeyboardScene scene={desk} class="scene__desk" />
    <KeyboardScene scene={pad} fit="meet" class="scene__pad" />
  </div>

  <div class="strip">
    <PosterHead id="keyboard" note="bright keys: this page · dark keys: the playground" />
  </div>

  <div class="console">
    <h2 id="keyboard-title" class="sr-only">Press a key</h2>
    <div class="screen" data-screen aria-hidden="true">
      <span class="screen__prompt">&gt;</span>
      <span class="screen__text" data-typed></span>
      <span class="screen__cursor"></span>
    </div>
    <p class="legend hint--desk">
      <span class="hint__row">
        <span class="hint__k">this page</span>
        {pageKeys.map((s) => <kbd>{s.key}</kbd>)}
      </span>
      <span class="hint__row hint__row--play">
        <span class="hint__k">playground</span>
        {playKeys.map((s) => <kbd>{s.key}</kbd>)}
      </span>
      <span class="hint__how">click a key, or type it on your own keyboard</span>
    </p>
    <p class="hint hint--pad label">tap a coloured key · the lime one opens the playground</p>
    <p class="psst voice hint--desk">psst — spell hello</p>
    <p class="psst voice hint--pad">psst — the ✦ key does something</p>
  </div>
</section>

<script>
  import { initKeyboard } from '../scripts/keyboard';
  document.querySelectorAll<SVGSVGElement>('svg[data-kb]').forEach(initKeyboard);
</script>

<style>
  .keyboard {
    --cut: clamp(48px, 9vw, 150px);
    /* the board's own stage: one screen tall */
    --stage: max(720px, 100svh);
    /* how far down that stage the highest key would sit */
    --key-top: min(calc(var(--stage) * var(--key-tall)), calc(var(--stage) / 2 - var(--key-wide)));
    /* lower the stage until that key is clear of the slant and the strip, and let the
       room grow by the same amount so nothing is lost off the bottom */
    --drop: max(0px, calc(var(--cut) + 60px - var(--key-top)));
    position: relative;
    z-index: 1;
    min-height: calc(var(--stage) + var(--drop));
    margin-top: calc(var(--cut) * -1);
    padding: 0;
    overflow: clip;
    /* the room arrives on the slant, cutting across the foot of the one above */
    clip-path: polygon(0 var(--cut), 100% 0, 100% 100%, 0 100%);
  }

  /* ── the wall of type ───────────────── */
  .wall {
    position: absolute;
    top: calc(var(--cut) + clamp(50px, 7svh, 90px));
    right: var(--gutter);
    left: var(--gutter);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 0.94;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
  }

  .wall span {
    display: block;
    /* an Anton capital averages a little under half an em, so n of them fill the measure */
    font-size: min(22vw, calc((100vw - 2 * var(--gutter)) / (var(--n) * 0.452)));
    transition:
      opacity 0.25s ease,
      translate 0.5s var(--ease-out);
  }

  .wall__live {
    position: absolute;
    top: 0;
    right: 0;
    color: var(--accent);
    text-align: right;
    opacity: 0;
    translate: 0 0.12em;
  }

  .wall.is-typing .wall__idle {
    opacity: 0;
    translate: 0 -0.12em;
  }

  .wall.is-typing .wall__live {
    opacity: 1;
    translate: 0 0;
  }

  /* ── the board ──────────────────────── */
  .scene {
    position: absolute;
    inset: var(--drop) 0 0;
  }

  .scene :global(.scene__desk) {
    width: 100%;
    height: 100%;
  }

  .scene :global(.scene__pad) {
    display: none;
  }

  .strip {
    position: absolute;
    top: calc(var(--cut) + 18px);
    right: var(--gutter);
    left: var(--gutter);
    pointer-events: none;
  }

  /* ── the console ────────────────────── */
  .console {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(26px, 6svh, 64px);
    z-index: 2;
    max-width: 36ch;
    pointer-events: none;
  }

  .screen {
    display: flex;
    align-items: center;
    gap: 10px;
    width: min(330px, 100%);
    height: 46px;
    padding: 0 16px;
    background: var(--c-ink);
    color: var(--marigold-pale);
    font: 500 15px/1 var(--font-mono);
    letter-spacing: 0.02em;
  }

  .screen__prompt {
    color: #ffffff;
  }

  .screen__text {
    overflow: hidden;
    white-space: pre;
  }

  .screen__cursor {
    flex: none;
    width: 9px;
    height: 17px;
    background: currentColor;
    animation: cursor 1s steps(2, jump-none) infinite;
  }

  @keyframes cursor {
    to {
      opacity: 0;
    }
  }

  .screen.is-party {
    animation: party 0.5s linear 5;
  }

  @keyframes party {
    0%,
    100% {
      background: var(--c-ink);
      color: var(--marigold-pale);
    }
    50% {
      background: var(--marigold-pale);
      color: var(--c-ink);
    }
  }

  .hint {
    margin: 16px 0 0;
    line-height: 2;
  }

  /* which keys go where */
  .legend {
    display: grid;
    gap: 7px;
    margin: 16px 0 0;
    font: 500 12px/1 var(--font-mono);
  }

  .hint__row {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .hint__k {
    width: 11ch;
  }

  .hint__row--play kbd {
    border-color: var(--c-ink);
    background: var(--c-ink);
    color: #f3f3ef;
  }

  .hint__row--play kbd:first-of-type {
    border-color: var(--play);
    background: var(--play);
    color: var(--c-ink);
  }

  .hint__how {
    margin-top: 4px;
    color: var(--fg-2);
  }

  .hint--pad {
    display: none;
  }

  .psst {
    margin: 6px 0 0;
    color: var(--accent);
    font-size: 22px;
    line-height: 1.15;
  }

  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 21px;
    height: 21px;
    padding: 0 4px;
    border: 1px solid currentColor;
    border-radius: 4px;
    font: 600 11px/1 var(--font-mono);
  }

  @media (max-width: 699px) {
    .keyboard {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: calc(var(--cut) + 18px) var(--gutter) 30px;
    }

    .strip {
      position: static;
      order: -1;
    }

    .wall {
      position: relative;
      top: auto;
      right: auto;
      left: auto;
      margin-top: 22px;
    }

    .scene {
      position: relative;
      inset: auto;
    }

    .scene :global(.scene__desk),
    .hint--desk {
      display: none;
    }

    .scene :global(.scene__pad) {
      display: block;
      width: 100%;
      height: auto;
      margin-top: 6px;
    }

    .console {
      position: relative;
      left: auto;
      bottom: auto;
      max-width: none;
      margin-top: 6px;
    }

    .hint--pad {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .screen.is-party {
      animation: none;
    }
  }
</style>
