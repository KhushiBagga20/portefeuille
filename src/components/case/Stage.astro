---
// How far along something is: done, in progress, or planned. One marker, used by the
// feature groups, the diagrams, the mind map and the timeline, so the three states always
// look the same.
import type { Stage } from '../../lib/types';

interface Props {
  stage: Stage;
  /** override the word, e.g. "working" for a feature that is done */
  word?: string;
  /** the mark without the word */
  bare?: boolean;
}
const { stage, bare = false } = Astro.props;
const word = Astro.props.word ?? { done: 'done', ongoing: 'in progress', planned: 'planned' }[stage];
---

<span class:list={['stage', `stage--${stage}`]}>
  <i aria-hidden="true"></i>
  <span class:list={{ 'sr-only': bare }}>{word}</span>
</span>

<style>
  .stage {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font: 500 12px/1 var(--font-mono);
    white-space: nowrap;
  }

  .stage i {
    flex: none;
    width: 9px;
    height: 9px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
  }

  .stage--done i {
    background: currentColor;
  }

  .stage--ongoing i {
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }

  .stage--planned i {
    border-style: dashed;
  }

  @media (prefers-reduced-motion: no-preference) {
    .stage--ongoing i {
      animation: stage-turn 2.4s linear infinite;
    }

    @keyframes stage-turn {
      to {
        rotate: 360deg;
      }
    }
  }
</style>
