---
// A project's history as a line you read downward: what is finished, what is being worked
// on, what is only planned. The three states never look alike — a solid mark, a turning
// one, a dashed one — and a date is shown only when one is actually known.
import StageMark from './Stage.astro';
import type { Milestone, Stage, Update } from '../../lib/types';

interface Props {
  milestones?: Milestone[];
  updates?: Update[];
}
const { milestones = [], updates = [] } = Astro.props;

type Entry = Milestone & { update?: boolean };
const entries: Entry[] = [
  ...milestones,
  ...[...updates]
    .sort((a, b) => a.date.localeCompare(b.date))
    .map((u) => ({ title: u.title, stage: u.stage ?? ('done' as Stage), date: u.date, body: u.body, media: u.media, update: true })),
];

const tally = (s: Stage) => entries.filter((e) => e.stage === s).length;
const kindWord = { milestone: 'milestone', achievement: 'achievement', challenge: 'challenge', recognition: 'recognition' };
---

<div class="tl">
  <p class="tl__key mono">
    {
      (['done', 'ongoing', 'planned'] as Stage[]).map((s) => (
        <span class:list={{ 'is-none': !tally(s) }}>
          <StageMark stage={s} /> {tally(s)}
        </span>
      ))
    }
  </p>

  <ol class="tl__list">
    {
      entries.map((e, i) => (
        <li class:list={['tl__item', `tl__item--${e.stage}`]} data-reveal style={`--i:${Math.min(i, 5)}`}>
          <div class="tl__when mono">
            {e.date ? <time datetime={e.date}>{e.date}</time> : <span>{String(i + 1).padStart(2, '0')}</span>}
            <span class="tl__stage">
              <StageMark stage={e.stage} />
            </span>
          </div>
          <span class="tl__rail" aria-hidden="true">
            <i class="tl__dot" />
          </span>
          <div class="tl__what">
            {(e.kind || e.update) && <p class="tl__kind mono">{e.update ? 'update' : kindWord[e.kind!]}</p>}
            <h3 class="tl__title">{e.title}</h3>
            {e.body && <p class="tl__body">{e.body}</p>}
            {e.items && (
              <ul class="tl__points">
                {e.items.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            )}
            {e.media?.map((m) => (
              <figure class="tl__media">
                {m.kind === 'image' ? (
                  <img src={m.src} alt={m.alt} width={m.width} height={m.height} loading="lazy" decoding="async" />
                ) : (
                  <video src={m.src} controls preload="metadata" aria-label={m.alt} />
                )}
                {m.caption && <figcaption>{m.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .tl__key {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 0;
  }

  .tl__key .is-none {
    opacity: 0.45;
  }

  .tl__list {
    margin: clamp(20px, 2.6vw, 36px) 0 0;
    padding: 0;
    list-style: none;
  }

  .tl__item {
    --gap: clamp(26px, 3.4vw, 50px);
    position: relative;
    display: grid;
    grid-template-columns: 96px 32px minmax(0, 1fr);
    gap: 0 clamp(10px, 1.6vw, 24px);
    padding-bottom: var(--gap);
  }

  .tl__item:last-child {
    padding-bottom: 0;
  }

  .tl__when {
    display: grid;
    align-content: start;
    gap: 8px;
    padding-top: 4px;
    text-align: right;
  }

  .tl__when > :first-child {
    font-size: 15px;
    font-weight: 600;
  }

  .tl__stage {
    color: var(--fg-2);
  }

  .tl__stage :global(.stage) {
    flex-direction: row-reverse;
  }

  /* the line, and the mark on it */
  .tl__rail {
    position: relative;
    justify-self: center;
    width: 16px;
  }

  .tl__rail::after {
    content: '';
    position: absolute;
    top: 27px;
    bottom: calc(-1 * var(--gap) - 1px);
    left: 50%;
    border-left: 2px solid var(--fg);
    translate: -50% 0;
  }

  .tl__item:last-child .tl__rail::after {
    display: none;
  }

  .tl__dot {
    display: block;
    width: 16px;
    height: 16px;
    margin-top: 5px;
    border: 2px solid var(--fg);
    border-radius: 50%;
    background: var(--fg);
  }

  .tl__item--ongoing .tl__dot {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .tl__item--planned .tl__dot {
    border-style: dashed;
    background: var(--bg);
  }

  .tl__item--planned .tl__rail::after,
  .tl__item--ongoing .tl__rail::after {
    border-left-style: dashed;
  }

  .tl__item--planned .tl__what {
    color: var(--fg-2);
  }

  .tl__kind {
    margin: 0 0 6px;
    color: var(--accent);
  }

  .tl__title {
    margin: 0;
    font: 400 var(--fs-head) / 1 var(--font-head);
    letter-spacing: -0.04em;
  }

  .tl__body {
    max-width: 58ch;
    margin: 12px 0 0;
    font-size: var(--fs-read);
    line-height: 1.6;
  }

  .tl__points {
    max-width: 58ch;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15.5px;
    line-height: 1.45;
  }

  .tl__points li {
    position: relative;
    padding: 8px 0 8px 22px;
    border-top: 1px solid var(--line);
  }

  .tl__points li::before {
    content: '';
    position: absolute;
    top: 1.1em;
    left: 2px;
    width: 9px;
    border-top: 2px solid currentColor;
  }

  .tl__media {
    max-width: 640px;
    margin: 18px 0 0;
  }

  .tl__media :is(img, video) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }

  .tl__media figcaption {
    margin-top: 8px;
    color: var(--fg-2);
    font-size: 14px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tl__item--ongoing .tl__dot {
      animation: tl-pulse 2.2s ease-in-out infinite;
    }

    @keyframes tl-pulse {
      50% {
        box-shadow: 0 0 0 9px color-mix(in srgb, var(--accent) 0%, transparent);
      }
    }
  }

  @media (max-width: 599px) {
    .tl__item {
      grid-template-columns: 22px minmax(0, 1fr);
      grid-template-areas:
        'dot when'
        'dot what';
      gap: 6px 14px;
    }

    .tl__when {
      grid-area: when;
      display: flex;
      align-items: center;
      gap: 14px;
      padding-top: 3px;
      text-align: left;
    }

    .tl__stage :global(.stage) {
      flex-direction: row;
    }

    .tl__rail {
      grid-area: dot;
    }

    .tl__what {
      grid-area: what;
    }
  }
</style>
