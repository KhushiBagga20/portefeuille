---
// A line of case-study text. When it ends in a bracketed list of source files, as
// generated studies do ("… (src/a.ts, src/b.ts)"), the files are lifted out of the
// sentence and set underneath as small labels. Spans only, so it can sit inside a button.
interface Props {
  text: string;
}
const { text } = Astro.props;

const isPath = (s: string) => !/\s/.test(s) && (s.includes('/') || /\.[a-z0-9]{1,6}$/i.test(s));
const m = text.match(/^([\s\S]*?)\s*\(([^()]+)\)\s*$/);
const parts = m ? m[2].split(',').map((s) => s.trim()).filter(Boolean) : [];
const cited = m !== null && parts.length > 0 && parts.every(isPath);
const body = cited ? m![1] : text;
const files = cited ? [...new Set(parts)] : [];
const name = (path: string) => path.split('/').pop()!;
---

{body}{
  files.length > 0 && (
    <span class="cite">
      <span class="cite__k">{files.length === 1 ? 'source' : 'sources'}</span>
      {files.map((f) => (
        <span class="cite__f" title={f}>
          {name(f)}
        </span>
      ))}
    </span>
  )
}

<style>
  .cite {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 5px;
    margin-top: 10px;
    font: 500 11px/1.3 var(--font-mono);
    letter-spacing: 0;
    text-transform: none;
  }

  .cite__k {
    margin-right: 3px;
    opacity: 0.7;
  }

  .cite__f {
    max-width: 100%;
    padding: 2px 6px;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow-wrap: anywhere;
  }
</style>
