---
// How a project took shape, as a map that opens branch by branch: the idea, the research,
// the challenges, the decisions, the implementation and what comes next.
//
// It is a real tree in the markup (nested lists, buttons that expand), drawn sideways with
// CSS connectors on wide screens and as an indented outline on narrow ones. A branch with
// nothing in it yet is still drawn — dashed, and saying so — so the gaps are visible.
import MindNodeItem from './MindNodeItem.astro';
import type { MindBranch, MindNode } from '../../lib/types';

interface Props {
  root: string;
  branches: { branch: MindBranch; nodes: MindNode[] }[];
}
const { root, branches } = Astro.props;

const words: Record<MindBranch, { name: string; ask: string }> = {
  idea: { name: 'The idea', ask: 'where it started' },
  research: { name: 'Research', ask: 'what was looked into first' },
  challenges: { name: 'Challenges', ask: 'what got in the way' },
  decisions: { name: 'Decisions', ask: 'what was chosen, and why' },
  implementation: { name: 'Implementation', ask: 'what was built' },
  future: { name: 'What next', ask: 'where it could go' },
};

const count = (nodes: MindNode[]): number => nodes.reduce((n, x) => n + 1 + count(x.children ?? []), 0);
const total = branches.reduce((n, b) => n + count(b.nodes), 0);
---

<div class="mm" data-mindmap>
  <div class="mm__bar">
    <p class="mm__sum mono">
      {branches.filter((b) => b.nodes.length).length} of {branches.length} branches written · {total} nodes
    </p>
    <div class="mm__tools" role="group" aria-label="Open or close the whole map">
      <button type="button" data-mm-all="open">open all</button>
      <button type="button" data-mm-all="close">close all</button>
    </div>
  </div>

  <div class="mm__scroll" tabindex="0" role="group" aria-label={`Mind map of ${root}. Scrolls sideways.`}>
    <ul class="mm__tree" role="tree" aria-label={`How ${root} took shape`}>
      <li class="mm__item mm__item--root" role="treeitem" aria-expanded="true">
        <span class="mm__node mm__node--root">{root}</span>
        <ul class="mm__kids" role="group">
          {
            branches.map((b) => {
              const empty = b.nodes.length === 0;
              return (
                <li class:list={['mm__item', 'mm__item--branch', { 'is-empty': empty }]} role="treeitem" aria-expanded={empty ? undefined : 'true'}>
                  {empty ? (
                    <span class="mm__node mm__node--branch mm__node--empty">
                      <span class="mm__label">{words[b.branch].name}</span>
                      <span class="mm__ask">not written yet</span>
                    </span>
                  ) : (
                    <button class="mm__node mm__node--branch" type="button" data-mm-toggle>
                      <span class="mm__label">{words[b.branch].name}</span>
                      <span class="mm__ask">{words[b.branch].ask}</span>
                      <i class="mm__n" aria-hidden="true">
                        {b.nodes.length}
                      </i>
                    </button>
                  )}
                  {!empty && (
                    <ul class="mm__kids" role="group">
                      {b.nodes.map((n) => (
                        <MindNodeItem node={n} />
                      ))}
                    </ul>
                  )}
                </li>
              );
            })
          }
        </ul>
      </li>
    </ul>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-mindmap]').forEach((map) => {
    map.addEventListener('click', (e) => {
      const button = (e.target as Element).closest<HTMLButtonElement>('[data-mm-toggle]');
      if (button) {
        const item = button.closest('[role="treeitem"]')!;
        item.setAttribute('aria-expanded', String(item.getAttribute('aria-expanded') !== 'true'));
        return;
      }
      const all = (e.target as Element).closest<HTMLButtonElement>('[data-mm-all]');
      if (all) {
        const open = all.dataset.mmAll === 'open';
        map.querySelectorAll('[role="treeitem"][aria-expanded]:not(.mm__item--root)').forEach((item) => {
          // closing keeps the six branches themselves in view
          const keep = !open && item.classList.contains('mm__item--branch');
          item.setAttribute('aria-expanded', String(open || keep));
        });
      }
    });

    // arrow keys walk the tree the way a file browser does
    map.addEventListener('keydown', (e) => {
      const button = (e.target as Element).closest<HTMLButtonElement>('[data-mm-toggle]');
      if (!button) return;
      const item = button.closest('[role="treeitem"]')!;
      const buttons = [...map.querySelectorAll<HTMLButtonElement>('[data-mm-toggle]')].filter((b) => b.offsetParent !== null);
      const i = buttons.indexOf(button);
      if (e.key === 'ArrowRight') item.setAttribute('aria-expanded', 'true');
      else if (e.key === 'ArrowLeft') item.setAttribute('aria-expanded', 'false');
      else if (e.key === 'ArrowDown') buttons[i + 1]?.focus();
      else if (e.key === 'ArrowUp') buttons[i - 1]?.focus();
      else return;
      e.preventDefault();
    });
  });
</script>

<style is:global>
  /* The node markup is produced by a recursive helper, so these rules are global and every
     class is prefixed. */
  .mm {
    --stub: 26px;
    --mm-line: color-mix(in srgb, var(--fg) 45%, transparent);
    container-type: inline-size;
  }

  .mm__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
  }

  .mm__sum {
    margin: 0;
    color: var(--fg-2);
  }

  .mm__tools {
    display: flex;
    border: 1px solid var(--line);
    border-radius: 999px;
    overflow: hidden;
  }

  .mm__tools button {
    height: 36px;
    padding: 0 14px;
    border: 0;
    background: none;
    color: var(--fg);
    font: 600 12px/1 var(--font-mono);
    cursor: pointer;
  }

  .mm__tools button + button {
    border-left: 1px solid var(--line);
  }

  .mm__tools button:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .mm__scroll {
    margin-top: clamp(16px, 2vw, 26px);
    padding: clamp(18px, 2.4vw, 34px) clamp(14px, 2vw, 28px);
    border: 1px solid var(--line);
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  .mm__scroll:focus-visible {
    outline-offset: -2px;
    box-shadow: none;
  }

  .mm__tree,
  .mm__kids {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ── sideways: node, then its children in a column to the right ── */
  .mm__item {
    position: relative;
    display: flex;
    align-items: center;
    padding: 5px 0 5px var(--stub);
  }

  .mm__item--root {
    padding-left: 0;
  }

  .mm__kids {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin-left: var(--stub);
  }

  /* the stub from a node across to its children's trunk */
  .mm__kids::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(var(--stub) * -1);
    width: var(--stub);
    border-top: 1.5px solid var(--mm-line);
  }

  /* each child: a stub in from the trunk… */
  .mm__kids > .mm__item::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: var(--stub);
    border-top: 1.5px solid var(--mm-line);
  }

  /* …and its share of the trunk */
  .mm__kids > .mm__item::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    border-left: 1.5px solid var(--mm-line);
  }

  .mm__kids > .mm__item:first-child::after {
    top: 50%;
  }

  .mm__kids > .mm__item:last-child::after {
    bottom: 50%;
  }

  .mm__kids > .mm__item:only-child::after {
    display: none;
  }

  /* ── nodes ──────────────────────────── */
  .mm__node {
    position: relative;
    z-index: 1;
    display: grid;
    flex: none;
    gap: 3px;
    max-width: 250px;
    min-width: 0;
    overflow-wrap: anywhere;
    padding: 9px 13px 8px;
    border: 1.5px solid var(--fg);
    border-radius: 10px;
    background: var(--bg);
    color: var(--fg);
    font: 650 14.5px/1.25 var(--font-body);
    letter-spacing: -0.012em;
    text-align: left;
  }

  button.mm__node {
    padding-right: 38px;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      translate 0.15s ease;
  }

  button.mm__node:hover {
    background: var(--fg);
    color: var(--bg);
  }

  button.mm__node:active {
    translate: 0 1px;
  }

  .mm__node--root {
    padding: 14px 18px 13px;
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
    font: 400 clamp(19px, 1.7vw, 25px) / 1 var(--font-head);
    letter-spacing: -0.035em;
  }

  .mm__node--branch {
    border-width: 2px;
  }

  .mm__node--branch .mm__label {
    font: 400 16px/1.1 var(--font-head);
    letter-spacing: -0.03em;
  }

  .mm__node--leaf {
    border-color: var(--line);
    font-weight: 550;
  }

  .mm__node--empty {
    border-style: dashed;
    color: var(--fg-2);
  }

  .mm__ask,
  .mm__stage {
    color: var(--fg-2);
    font: 500 11.5px/1.3 var(--font-mono);
    letter-spacing: 0;
    transition: color 0.2s ease;
  }

  button.mm__node:hover :is(.mm__ask, .mm__stage) {
    color: inherit;
  }

  /* how many are inside, and whether they're showing */
  .mm__n {
    position: absolute;
    top: 50%;
    right: 9px;
    display: grid;
    place-items: center;
    min-width: 21px;
    height: 21px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font: 600 11px/1 var(--font-mono);
    translate: 0 -50%;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  button.mm__node:hover .mm__n {
    background: var(--bg);
    color: var(--fg);
  }

  [aria-expanded='true'] > button.mm__node .mm__n {
    background: var(--accent);
    color: var(--on-accent);
  }

  .mm__note {
    display: none;
    color: var(--fg-2);
    font-size: 13.5px;
    font-weight: 450;
    line-height: 1.45;
  }

  button.mm__node:hover .mm__note {
    color: inherit;
  }

  [aria-expanded='true'] > .mm__node .mm__note {
    display: block;
  }

  /* an open note needs room to be read, and the marker moves out of its way */
  [aria-expanded='true'] > .mm__node--leaf {
    max-width: min(340px, 78vw);
  }

  [aria-expanded='true'] > .mm__node--leaf .mm__n {
    top: 9px;
    translate: none;
  }

  /* ── opening and closing ────────────── */
  .mm__item[aria-expanded='false'] > .mm__kids {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mm__item[aria-expanded='true'] > .mm__kids > .mm__item {
      animation: mm-grow 0.4s var(--ease-out) backwards;
    }

    .mm__kids > .mm__item:nth-child(2) {
      animation-delay: 40ms;
    }
    .mm__kids > .mm__item:nth-child(3) {
      animation-delay: 80ms;
    }
    .mm__kids > .mm__item:nth-child(4) {
      animation-delay: 120ms;
    }
    .mm__kids > .mm__item:nth-child(n + 5) {
      animation-delay: 160ms;
    }

    @keyframes mm-grow {
      from {
        opacity: 0;
        translate: -14px 0;
      }
    }
  }

  /* ── narrow: the same tree as an indented outline ── */
  @container (max-width: 760px) {
    .mm__scroll {
      overflow-x: visible;
    }

    .mm__item {
      flex-direction: column;
      align-items: stretch;
      padding: 4px 0 4px 18px;
    }

    .mm__item--root {
      padding-left: 0;
    }

    .mm__node {
      max-width: none;
    }

    .mm__kids {
      margin: 0 0 0 10px;
    }

    .mm__kids::before {
      display: none;
    }

    .mm__kids > .mm__item::before {
      top: 24px;
      width: 18px;
    }

    .mm__kids > .mm__item::after {
      top: 0;
      bottom: 0;
    }

    .mm__kids > .mm__item:first-child::after {
      top: 0;
    }

    .mm__kids > .mm__item:last-child::after {
      bottom: calc(100% - 24px);
    }

    .mm__kids > .mm__item:only-child::after {
      display: block;
    }
  }
</style>
