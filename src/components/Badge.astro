---
import type { Label } from '../data/projects';

interface Props {
  label: Label;
}

const { label } = Astro.props;
// results get a filled tag; everything else is an outline
const loud = label === 'Recognition';
---

<span class:list={['tag', loud && 'tag--loud']}>{label}</span>

<style>
  .tag--loud {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }
</style>
