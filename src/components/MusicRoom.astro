---
// The record room: a dark listening room. A crate to dig through, a deck that works,
// and now the whole collection as an index you can search and sort by artist.
//
// Every title, artist, cover and running time is Spotify's (src/data/playlist.json);
// their own player does the streaming. The deck and its state machine are unchanged
// (Turntable.astro, scripts/turntable.ts) — this file is the room around them.
import Arrow from './Arrow.astro';
import PosterHead from './PosterHead.astro';
import Sleeve from './Sleeve.astro';
import Turntable from './Turntable.astro';
import { CRATE, deckLabel, playlist, roomNote, tintFor } from '../data/music';

interface Props {
  /** the room number and name for the strip along the top */
  index: string;
  name: string;
  level?: 'h1' | 'h2';
}
const { index, name, level = 'h1' } = Astro.props;
const Heading = level;

const tracks = playlist.tracks;
const crate = tracks.slice(0, CRATE);
const tilts = [-2.4, 1.8, -1.2, 2.6, -2, 1.3, -2.8, 2.1, -1.6];
const shifts = [0, 16, -10, 22, -6, 12, -18, 8, -14];

// Spotify joins collaborators with a comma and a no-break space.
const namesOf = (credit: string) => credit.split(/, /).map((n) => n.trim());
const tally = new Map<string, number>();
for (const t of tracks) for (const name of namesOf(t.artist)) tally.set(name, (tally.get(name) ?? 0) + 1);
const artists = [...tally].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const clock = (ms: number | null) => {
  if (!ms) return '';
  const s = Math.round(ms / 1000);
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
};
const total = tracks.reduce((n, t) => n + (t.duration ?? 0), 0);
const hours = Math.floor(total / 3_600_000);
const mins = Math.round((total % 3_600_000) / 60_000);
const no = (i: number) => String(i + 1).padStart(3, '0');

// "Sleeves": the collection grouped by cover art. The playlist data has no album names,
// so this is the honest version of browsing by album — one tile per distinct sleeve.
// Spotify serves each cover in three sizes; the tiles and the thumbnail use the 300px one.
const small = (cover: string) => cover.replace('ab67616d0000b273', 'ab67616d00001e02');
const sleeveOf = new Map<string, number>();
const sleeves: { key: number; cover: string; count: number; title: string; artist: string }[] = [];
for (const t of tracks) {
  if (!t.cover) continue;
  let key = sleeveOf.get(t.cover);
  if (key === undefined) {
    key = sleeves.length;
    sleeveOf.set(t.cover, key);
    sleeves.push({ key, cover: small(t.cover), count: 0, title: t.title, artist: t.artist });
  }
  sleeves[key].count++;
}

// The browser needs the whole playlist to dig through and to shuffle.
const payload = {
  url: playlist.url,
  name: playlist.name,
  crate: CRATE,
  tracks: tracks.map((t) => ({ ...t, label: tintFor(t.id).label, paper: tintFor(t.id).paper })),
};
---

<section id="records" class="room poster s-ink" data-room data-playing="false" data-playlist={JSON.stringify(payload)} aria-labelledby="room-title">
  <!-- one very large record, most of it off the edge of the room -->
  <div class="plate" aria-hidden="true">
    <span class="plate__disc"><span class="plate__label" data-plate-label></span></span>
  </div>

  <div class="wrap">
    <PosterHead index={index} name={name} note={`${tracks.length} tracks · ${artists.length} artists · ${hours} h ${String(mins).padStart(2, '0')} min`} />

    <header class="room__head">
      <Heading id="room-title" class="room__title">Records</Heading>
      <p class="room__note voice">{roomNote}</p>
    </header>

    <div class="room__body">
      <!-- ── the crate ────────────────────────── -->
      <div class="shelf">
        <h3 class="shelf__title label" id="shelf-title">the crate</h3>
        <p class="shelf__hint">
          <span data-crate-range>{`001–${String(crate.length).padStart(3, '0')}`}</span> of {tracks.length} · pick one up and put it on
        </p>
        <ul class="stack" aria-labelledby="shelf-title">
          {
            crate.map((t, i) => (
              <li class="stack__item" style={`--r:${tilts[i % tilts.length]}deg;--x:${shifts[i % shifts.length]}px`}>
                <button class="pick" type="button" data-pick={i} aria-pressed="false">
                  <span class="sr-only">Put on </span>
                  <span class="pick__disc" aria-hidden="true" style={`--label:${tintFor(t.id).label}`} />
                  <Sleeve track={t} />
                  <span class="pick__meta">
                    <span class="pick__title" data-pick-title>{t.title}</span>
                    <span class="pick__artist" data-pick-artist>{t.artist}</span>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
        <button class="key key--sm dig" type="button" data-dig>dig deeper <Arrow dir="down" /></button>
      </div>

      <!-- ── the deck ─────────────────────────── -->
      <div class="deck-area">
        <div class="deck-area__table">
          <Turntable />
        </div>

        <p class="deck-area__label voice">{deckLabel}</p>

        <div class="panel" role="group" aria-label="Turntable controls">
          <button class="panel__btn" type="button" data-prev aria-label="Previous record">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14L8 12zM6 5h2.4v14H6z" /></svg>
          </button>
          <button class="panel__btn panel__btn--main" type="button" data-toggle aria-pressed="false">
            <svg class="panel__play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5 20 12 7 19.5z" /></svg>
            <svg class="panel__stop" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" /></svg>
            <span class="sr-only" data-toggle-label>Play</span>
          </button>
          <button class="panel__btn" type="button" data-next aria-label="Next record">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14l10-7zM15.6 5H18v14h-2.4z" /></svg>
          </button>
          <button class="panel__btn" type="button" data-shuffle aria-label="Shuffle: play anything from the playlist">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M3 7h3.5l3 5M3 17h3.5l3-5M21 7h-4m4 0-2.5-2.5M21 7l-2.5 2.5M21 17h-4m4 0-2.5-2.5M21 17l-2.5 2.5M13.5 7H17M13.5 17H17"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="square"></path>
            </svg>
          </button>

          <div class="panel__rpm" role="group" aria-label="Platter speed">
            <button class="rpm" type="button" data-rpm="33" aria-pressed="true">33⅓</button>
            <button class="rpm" type="button" data-rpm="45" aria-pressed="false">45</button>
          </div>
        </div>

        <p class="panel__note label">the speed and pitch move the platter — Spotify keeps its own tempo.</p>

        <!-- ── what's on ─────────────────────── -->
        <div class="now" data-now>
          <p class="now__empty voice" data-now-empty>nothing on the platter yet — pick a record.</p>
          <div class="now__card" data-now-card hidden>
            <span class="now__cover" data-now-cover aria-hidden="true"></span>
            <div class="now__text" data-now-text>
              <p class="now__tag mono">
                <i aria-hidden="true"></i>now playing
                <span data-now-no></span>
              </p>
              <p class="now__line">
                <strong data-now-title></strong>
                <span data-now-artist></span>
              </p>
              <p class="now__time mono" data-now-time></p>
            </div>
            <p class="now__cue" data-cue hidden>
              your browser is holding playback — press play in the Spotify bar below.
            </p>
            <a class="key key--sm" data-now-link href={playlist.url} target="_blank" rel="noopener">
              open in Spotify<span class="sr-only"> (opens in a new tab)</span>
              <Arrow dir="out" />
            </a>
          </div>
        </div>

        <!-- Spotify's own player: it does the actual streaming. -->
        <div class="amp" data-amp>
          <p class="amp__label label">
            <span class="amp__dot" aria-hidden="true"></span>
            streaming from
            <a class="link" href={playlist.url} target="_blank" rel="noopener">
              Spotify · {playlist.name}<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </p>
          <div class="amp__embed">
            <p class="amp__idle label">the player loads when you put a record on</p>
            <div data-embed></div>
          </div>
          <p class="amp__fineprint">
            Full tracks play if you're signed in to Spotify; otherwise you get a 30-second preview.
          </p>
        </div>
      </div>

      <!-- ── the index: all of it ─────────────── -->
      <div class="index" data-library data-view="songs">
        <div class="index__top">
          <div class="index__tabs" role="group" aria-label="Browse the collection by">
            <button class="index__tab" type="button" data-index-view="songs" aria-pressed="true">
              songs <sup>{tracks.length}</sup>
            </button>
            <button class="index__tab" type="button" data-index-view="artists" aria-pressed="false">
              artists <sup>{artists.length}</sup>
            </button>
            <button class="index__tab" type="button" data-index-view="sleeves" aria-pressed="false">
              sleeves <sup>{sleeves.length}</sup>
            </button>
          </div>
          <a class="index__playlist label link" href={playlist.url} target="_blank" rel="noopener">
            the playlist<span class="sr-only"> on Spotify (opens in a new tab)</span>
            <Arrow dir="out" />
          </a>
        </div>

        <div class="index__songs">
          <label class="index__find">
            <span class="sr-only">Filter songs by title or artist</span>
            <input type="search" placeholder="filter by title or artist" autocomplete="off" spellcheck="false" data-index-find />
          </label>
          <p class="index__state label" aria-live="polite">
            <span data-index-count>{tracks.length} of {tracks.length}</span>
            <button class="index__clear link" type="button" data-index-clear hidden>clear filter</button>
          </p>
          <ol class="tracks" data-tracks>
            {
              tracks.map((t, i) => (
                <li data-names={namesOf(t.artist).join('|')} data-sleeve={t.cover ? sleeveOf.get(t.cover) : undefined}>
                  <button class="track" type="button" data-track={i}>
                    <span class="track__no">{no(i)}</span>
                    <span class="track__title">{t.title}</span>
                    <span class="track__artist">{t.artist}</span>
                    <span class="track__time">{clock(t.duration)}</span>
                  </button>
                </li>
              ))
            }
          </ol>
          <p class="index__none voice" data-index-none hidden>nothing by that name in here.</p>
        </div>

        <!-- every distinct cover in the collection: pick one to see what's inside it -->
        <ul class="sleeves" data-sleeves>
          {
            sleeves.map((sl) => (
              <li>
                <button
                  class="tile"
                  type="button"
                  data-sleeve-pick={sl.key}
                  aria-label={`${sl.count} ${sl.count === 1 ? 'track' : 'tracks'} in this sleeve: ${sl.title}, ${sl.artist}${sl.count > 1 ? ' and more' : ''}`}
                >
                  <img src={sl.cover} alt="" width="300" height="300" loading="lazy" decoding="async" />
                  {sl.count > 1 && <i>{sl.count}</i>}
                </button>
              </li>
            ))
          }
        </ul>

        <ul class="names" data-names-list>
          {
            artists.map(([name, n]) => (
              <li>
                <button class="name" type="button" data-artist={name} style={`--n:${n}`}>
                  {name}
                  <sup>{n}</sup>
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- the record in transit, between sleeve and platter -->
  <div class="flier" data-flier aria-hidden="true">
    <span class="flier__disc" data-flier-disc></span>
  </div>
</section>

<script>
  import { initMusicRoom } from '../scripts/turntable';
  document.querySelectorAll<HTMLElement>('[data-room]').forEach(initMusicRoom);

  // ── the index: two views and a filter. Playing a row is the deck's job (turntable.ts). ──
  document.querySelectorAll<HTMLElement>('[data-library]').forEach((index) => {
    const rows = [...index.querySelectorAll<HTMLLIElement>('[data-tracks] > li')];
    const find = index.querySelector<HTMLInputElement>('[data-index-find]')!;
    const count = index.querySelector<HTMLElement>('[data-index-count]')!;
    const clear = index.querySelector<HTMLButtonElement>('[data-index-clear]')!;
    const none = index.querySelector<HTMLElement>('[data-index-none]')!;
    const views = [...index.querySelectorAll<HTMLButtonElement>('[data-index-view]')];
    let artist = '';
    let sleeve = '';

    const haystack = rows.map((row) => (row.textContent ?? '').toLowerCase());

    const apply = () => {
      const q = find.value.trim().toLowerCase();
      let shown = 0;
      rows.forEach((row, i) => {
        const hit =
          (!artist || (row.dataset.names ?? '').split('|').includes(artist)) && (!sleeve || row.dataset.sleeve === sleeve) && (!q || haystack[i].includes(q));
        row.hidden = !hit;
        if (hit) shown++;
      });
      count.textContent = artist ? `${shown} by ${artist}` : sleeve ? `${shown} in this sleeve` : `${shown} of ${rows.length}`;
      clear.hidden = !(artist || sleeve || q);
      none.hidden = shown > 0;
    };

    const view = (name: string) => {
      index.dataset.view = name;
      views.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.indexView === name)));
    };

    views.forEach((b) => b.addEventListener('click', () => view(b.dataset.indexView!)));
    find.addEventListener('input', apply);
    clear.addEventListener('click', () => {
      artist = '';
      sleeve = '';
      find.value = '';
      apply();
    });
    index.querySelectorAll<HTMLButtonElement>('[data-sleeve-pick]').forEach((b) =>
      b.addEventListener('click', () => {
        sleeve = b.dataset.sleevePick!;
        artist = '';
        find.value = '';
        apply();
        view('songs');
        index.querySelector<HTMLElement>('[data-tracks]')!.scrollTop = 0;
      }),
    );
    index.querySelectorAll<HTMLButtonElement>('[data-artist]').forEach((b) =>
      b.addEventListener('click', () => {
        artist = b.dataset.artist!;
        sleeve = '';
        find.value = '';
        apply();
        view('songs');
        index.querySelector<HTMLElement>('[data-tracks]')!.scrollTop = 0;
      }),
    );
  });
</script>

<style>
  .room {
    min-height: calc(100svh - var(--bar));
    padding-top: clamp(18px, 2.4vw, 34px);
    overflow: clip;
  }

  /* ── the oversized record ───────────── */
  .plate {
    position: absolute;
    top: calc(-1 * clamp(50px, 7vw, 130px));
    right: calc(-1 * clamp(70px, 8vw, 150px));
    width: clamp(260px, 30vw, 540px);
    pointer-events: none;
  }

  .plate__disc {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 0 21.5%, rgb(255 255 255 / 0.07) 21.5% 22%, transparent 22%),
      repeating-radial-gradient(circle, #1d1f44 0 2px, #101230 2px 5px);
    animation: spin 14s linear infinite;
    animation-play-state: paused;
  }

  .room[data-playing='true'] .plate__disc {
    animation-play-state: running;
  }

  .plate__label {
    width: 34%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent) center / cover no-repeat;
    box-shadow: inset 0 0 0 clamp(8px, 1.1vw, 18px) rgb(12 13 33 / 0.28);
  }

  .plate__label::after {
    content: '';
    display: block;
    width: 9%;
    aspect-ratio: 1;
    margin: 45.5% auto 0;
    border-radius: 50%;
    background: var(--bg);
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  /* ── head ───────────────────────────── */
  .room__head {
    margin-top: clamp(20px, 3vw, 44px);
  }

  .room__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(64px, 12.4vw, 232px);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .room__note {
    max-width: 22ch;
    margin: clamp(14px, 2vw, 26px) 0 0;
    color: var(--accent);
    font-size: clamp(21px, 2vw, 32px);
    line-height: 1.12;
  }

  .room__body {
    display: grid;
    grid-template-columns: minmax(170px, 0.46fr) minmax(0, 1.3fr) minmax(0, 0.92fr);
    align-items: start;
    gap: clamp(24px, 3.4vw, 56px);
    margin-top: clamp(30px, 4.2vw, 64px);
  }

  /* ── crate ───────────────────────────── */
  .shelf__title {
    margin: 0;
  }

  .shelf__hint {
    margin: 6px 0 0;
    color: var(--fg-2);
    font-size: 15px;
  }

  .stack {
    max-width: 250px;
    margin: 22px 0 0;
    padding: 0 0 32px;
    list-style: none;
  }

  .stack__item {
    position: relative;
    z-index: 2;
  }

  .stack__item + .stack__item {
    margin-top: -32%;
  }

  .dig {
    margin-top: 4px;
  }

  .pick {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    rotate: var(--r);
    translate: var(--x) 0;
    transition:
      translate 0.4s var(--ease-out),
      rotate 0.4s var(--ease-out),
      filter 0.3s ease;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) {
    .stack:hover .pick {
      filter: saturate(0.8) brightness(0.86);
    }

    .stack__item:hover .pick,
    .pick:focus-visible {
      translate: calc(var(--x) + 10px) -14px;
      rotate: calc(var(--r) * 0.3);
      filter: none;
      z-index: 3;
    }

    .stack__item:hover + .stack__item .pick {
      translate: var(--x) 12px;
    }
  }

  .pick[aria-pressed='true'] {
    translate: calc(var(--x) + 16px) -10px;
    rotate: 0deg;
  }

  .pick:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    box-shadow: none;
  }

  .pick__disc {
    position: absolute;
    top: 6%;
    right: -6%;
    width: 88%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--label) 0 17%, transparent 17%),
      repeating-radial-gradient(circle, #262a55 0 2px, #14163a 2px 4px);
    box-shadow: 2px 3px 8px rgb(0 0 0 / 0.5);
    transition: right 0.45s var(--spring);
  }

  @media (hover: hover) {
    .stack__item:hover .pick__disc {
      right: -14%;
    }
  }

  /* The title only surfaces when you reach for the sleeve, so the pile stays a pile. */
  .pick__meta {
    position: absolute;
    top: calc(100% + 10px);
    left: 2px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    max-width: 100%;
    text-align: left;
    opacity: 0;
    translate: 0 -6px;
    transition:
      opacity 0.25s ease,
      translate 0.25s var(--ease-out);
  }

  .stack__item:hover .pick__meta,
  .pick:focus-visible .pick__meta,
  .pick[aria-pressed='true'] .pick__meta {
    opacity: 1;
    translate: 0 0;
  }

  .pick__title {
    overflow: hidden;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 400;
    line-height: 1;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .pick__artist {
    overflow: hidden;
    color: var(--fg-2);
    font: 700 10px/1.3 var(--font-label);
    letter-spacing: 0.08em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── deck ────────────────────────────── */
  .deck-area__table {
    position: relative;
    z-index: 1;
    max-width: 700px;
    margin: 0 auto;
  }

  .deck-area__label {
    margin: 2px 0 0;
    color: var(--fg-2);
    font-size: 22px;
    line-height: 1;
    text-align: center;
  }

  .panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 18px auto 0;
  }

  .panel__note {
    max-width: 44ch;
    margin: 14px auto 0;
    color: var(--fg-2);
    font-size: 10px;
    line-height: 1.6;
    text-align: center;
    font: 500 12.5px/1.45 var(--font-body);
    letter-spacing: 0;
    text-transform: none;
  }

  .panel__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1.5px solid var(--fg);
    border-radius: 50%;
    background: none;
    color: var(--fg);
    cursor: pointer;
    transition:
      background-color 0.18s ease,
      color 0.18s ease,
      translate 0.1s ease;
  }

  .panel__btn svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .panel__btn:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .panel__btn:active {
    translate: 0 2px;
  }

  .panel__btn--main {
    width: 64px;
    height: 64px;
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .panel__btn--main:hover {
    border-color: var(--fg);
  }

  .panel__btn--main svg {
    width: 26px;
    height: 26px;
  }

  .panel__stop {
    display: none;
  }

  .panel__btn--main[aria-pressed='true'] .panel__play {
    display: none;
  }

  .panel__btn--main[aria-pressed='true'] .panel__stop {
    display: block;
  }

  .panel__rpm {
    display: flex;
    margin-left: 6px;
    border: 1.5px solid var(--fg);
    border-radius: 999px;
    overflow: hidden;
  }

  .rpm {
    min-width: 50px;
    padding: 0 12px;
    height: 36px;
    border: 0;
    background: none;
    color: var(--fg);
    font: 700 11px/1 var(--font-label);
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .rpm[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
  }

  /* ── now playing ─────────────────────── */
  .now {
    max-width: 560px;
    margin: 22px auto 0;
  }

  .now__empty {
    margin: 0;
    color: var(--fg-2);
    font-size: 22px;
    line-height: 1.2;
