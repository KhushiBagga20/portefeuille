---
// About, as a modular poster: one board of cells on a hairline grid, each cell a
// different scale of the same few facts. The sentence at headline size, two numbers as
// large as they'll go, an ID that leans toward the cursor and turns over, a list, and a
// marigold you can spin.
import { Image } from 'astro:assets';
import PosterHead from './PosterHead.astro';
import Rosette from './Rosette.astro';
import { chapter } from '../data/chapters';
import { about, education, languages } from '../data/profile';
import { site } from '../data/site';
import drawing from '../assets/collage/illustration.png';

const c = chapter('about');
const [lead, ...more] = about.paragraphs;

// The course name is set in the quieter voice wherever the lead sentence mentions it.
const at = lead.indexOf(education.focus);
const parts = at < 0 ? [lead] : [lead.slice(0, at), education.focus, lead.slice(at + education.focus.length)];

const [grade, outOf] = education.cgpa.split('/');
---

<section id="about" class="about poster s-paper" {...c.attrs} aria-labelledby="about-title">
  <div class="wrap">
    <PosterHead id="about" note={`${site.fullName} · ${education.school}`} />
    <h2 id="about-title" class="sr-only">About</h2>

    <div class="board">
      <!-- the sentence -->
      <div class="cell cell--say">
        <p class="say" data-reveal>
          {parts.length === 3 ? <Fragment>{parts[0]}<em>{parts[1]}</em>{parts[2]}</Fragment> : lead}
        </p>
      </div>

      <!-- class of -->
      <div class="cell cell--year">
        <p class="cell__label">class of</p>
        <p class="figure" data-count data-from={education.started} data-to={education.graduation}>{education.graduation}</p>
        <p class="cell__foot">{education.degree}</p>
      </div>

      <!-- the ID -->
      <div class="cell cell--id">
        <span class="lanyard" aria-hidden="true"></span>
        <div class="id" data-id data-tilt>
          <div class="id__inner">
            <article class="id__face id__front" aria-labelledby="id-title" data-id-front>
              <span class="id__slot" aria-hidden="true"></span>
              <header class="id__bar">
                <span id="id-title">student id</span>
                <span>{education.started}—{education.graduation}</span>
              </header>
              <div class="id__body">
                <div class="id__photo">
                  <Image src={drawing} alt="" width={240} height={300} loading="eager" />
                </div>
                <dl class="id__facts">
                  <div>
                    <dt>name</dt>
                    <dd>{site.fullName}</dd>
                  </div>
                  <div>
                    <dt>university</dt>
                    <dd>{education.school}</dd>
                  </div>
                  <div>
                    <dt>degree</dt>
                    <dd>{education.degree}</dd>
                  </div>
                  <div>
                    <dt>focus</dt>
                    <dd>{education.focus}</dd>
                  </div>
                </dl>
              </div>
              <div class="id__barcode" aria-hidden="true"></div>
            </article>

            <article class="id__face id__back" aria-labelledby="id-back-title" data-id-back inert>
              <header class="id__bar">
                <span id="id-back-title">coursework</span>
                <span>reverse</span>
              </header>
              <ol class="id__courses">
                {education.coursework.map((course) => <li>{course}</li>)}
              </ol>
              <dl class="id__row">
                <div>
                  <dt>languages</dt>
                  <dd>{languages.join(' · ')}</dd>
                </div>
              </dl>
              <div class="id__barcode" aria-hidden="true"></div>
            </article>
          </div>
          <span class="id__glare" aria-hidden="true"></span>
        </div>

        <button class="key key--sm id__flip" type="button" data-id-flip aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 12a8 8 0 0 1 13.7-5.6M20 12a8 8 0 0 1-13.7 5.6M18 2v5h-5M6 22v-5h5" fill="none" stroke="currentColor" stroke-width="2"></path>
          </svg>
          <span data-id-flip-label>turn it over</span>
        </button>
      </div>

      <!-- the rest of the thought -->
      <div class="cell cell--more">
        <p class="cell__label">in short</p>
        {more.map((p) => <p class="more">{p}</p>)}
      </div>

      <!-- the grade -->
      <div class="cell cell--grade">
        <p class="cell__label">cgpa</p>
        <p class="figure" data-count data-from="0" data-to={grade} data-step="0.1">{grade}</p>
        <p class="cell__foot">out of {outOf}</p>
      </div>

      <!-- the list -->
      <div class="cell cell--likes">
        <p class="cell__label">things I get excited about</p>
        <ol class="likes">
          {
            about.interests.map((item, i) => (
              <li>
                <span class="likes__no">{String(i + 1).padStart(2, '0')}</span>
                <span class="likes__name">{item}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- the marigold -->
      <div class="cell cell--bloom">
        <p class="cell__label">spin it</p>
        <div class="bloom" data-spin aria-hidden="true">
          <Rosette
            rings={[
              { n: 18, at: 76, r: 14.5, fill: 'var(--marigold)', rate: 1 },
              { n: 13, at: 52, r: 14, fill: 'var(--marigold-pale)', rate: -1.6 },
              { n: 9, at: 30, r: 12.5, fill: 'var(--marigold-deep)', rate: 2.3 },
            ]}
            core={{ r: 11, fill: 'var(--signal)' }}
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initSpin } from '../scripts/spin';

  document.querySelectorAll<HTMLElement>('[data-spin]').forEach(initSpin);

  // The card turns over. Whichever face is away from you is taken out of the tab order.
  document.querySelectorAll<HTMLElement>('[data-id]').forEach((card) => {
    const button = card.parentElement?.querySelector<HTMLButtonElement>('[data-id-flip]');
    const label = button?.querySelector<HTMLElement>('[data-id-flip-label]');
    const front = card.querySelector<HTMLElement>('[data-id-front]');
    const back = card.querySelector<HTMLElement>('[data-id-back]');
    if (!button || !front || !back) return;

    const set = (flipped: boolean) => {
      card.classList.toggle('is-flipped', flipped);
      button.setAttribute('aria-pressed', String(flipped));
      if (label) label.textContent = flipped ? 'back to the front' : 'turn it over';
      front.toggleAttribute('inert', flipped);
      back.toggleAttribute('inert', !flipped);
    };
    button.addEventListener('click', () => set(!card.classList.contains('is-flipped')));
    card.addEventListener('click', () => set(!card.classList.contains('is-flipped')));
  });

  // The two big figures count up to themselves the first time they're seen:
  // the years from when she started to when she finishes, the grade from nought.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const counters = [...document.querySelectorAll<HTMLElement>('[data-count]')];
  if (!reduce.matches && counters.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          io.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const from = Number(el.dataset.from);
          const to = Number(el.dataset.to);
          const step = Number(el.dataset.step ?? 1);
          const places = step < 1 ? 1 : 0;
          if (!Number.isFinite(from) || !Number.isFinite(to)) continue;
          const start = performance.now();
          const ms = 1100;
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / ms);
            const eased = 1 - (1 - t) ** 3;
            const value = from + Math.round(((to - from) * eased) / step) * step;
            el.textContent = (t < 1 ? value : to).toFixed(places);
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.7 },
    );
    counters.forEach((el) => io.observe(el));
  }
</script>

<style>
  /* ── the board: cells on a hairline grid ─────────────
     The grid's own colour shows through 1px gaps, which is what draws the lines. */
  .board {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-areas:
      'say  say  say  say  say  say  say  say  year  year  year  year'
      'id   id   id   id   more more more more grade grade grade grade'
      'id   id   id   id   like like like like like  bloom bloom bloom';
    gap: 1px;
    margin-top: clamp(22px, 3vw, 44px);
    border: 1px solid var(--fg);
    background: var(--fg);
  }

  .cell {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(16px, 2vw, 30px);
    background: var(--bg);
  }

  .cell--say {
    grid-area: say;
    justify-content: center;
    padding-block: clamp(24px, 4vw, 64px);
  }

  .cell--year {
    grid-area: year;
    background: var(--cobalt);
    color: #ffffff;
  }

  .cell--id {
    grid-area: id;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding-top: clamp(48px, 6vw, 90px);
    background: var(--paper-2);
    overflow: clip;
  }

  .cell--more {
    grid-area: more;
  }

  .cell--grade {
    grid-area: grade;
    background: var(--marigold);
    color: var(--c-ink);
  }

  .cell--likes {
    grid-area: like;
    background: var(--c-ink);
    color: var(--c-paper);
  }

  .cell--bloom {
    grid-area: bloom;
    overflow: clip;
  }

  .cell__label,
  .cell__foot {
    margin: 0;
    font: 600 semi-expanded 11px/1.3 var(--font-label);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .cell__foot {
    margin-top: auto;
  }

  /* the sentence */
  .say {
    max-width: 21ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(30px, 4.5vw, 76px);
    font-stretch: 82%;
    font-weight: 750;
    line-height: 0.98;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .say em {
    color: var(--accent);
    font-stretch: 100%;
    font-style: normal;
    font-weight: 300;
    letter-spacing: -0.03em;
  }

  /* a number as large as its cell */
  .figure {
    margin: auto 0 0;
    padding: 0.14em 0 0.06em;
    font-family: var(--font-display);
    font-size: clamp(96px, 14.2vw, 250px);
    font-stretch: 62%;
    font-weight: 900;
    line-height: 0.74;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .cell--year .cell__foot,
  .cell--grade .cell__foot {
    margin-top: clamp(10px, 1.2vw, 16px);
  }

  .more {
    margin: auto 0 0;
    padding-top: 24px;
    font-size: clamp(17px, 1.42vw, 21px);
    line-height: 1.42;
  }

  /* the list */
  .likes {
    margin: clamp(14px, 1.8vw, 24px) 0 0;
    padding: 0;
    list-style: none;
  }

  .likes li {
    display: grid;
    grid-template-columns: 4ch 1fr;
    align-items: baseline;
    padding: 8px 0 6px;
    border-top: 1px solid rgb(243 243 239 / 0.22);
    transition:
      padding-left 0.3s var(--ease-out),
      color 0.2s ease;
  }

  .likes li:hover {
    padding-left: 12px;
    color: var(--marigold);
  }

  .likes__no {
    font: 600 semi-expanded 10px/1 var(--font-label);
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  .likes__name {
    font-family: var(--font-display);
    font-size: clamp(19px, 2.05vw, 33px);
    font-stretch: 70%;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  /* the marigold: too big for its cell on purpose */
  .bloom {
    width: 132%;
    margin: auto -16% -30% auto;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .bloom:active {
    cursor: grabbing;
  }

  /* ── the ID ─────────────────────────── */
  .lanyard {
    position: absolute;
    top: 0;
    left: 50%;
    width: 22px;
    height: clamp(64px, 7vw, 108px);
    background: var(--fg);
    translate: -50% 0;
  }

  .id {
    --tx: 0;
    --ty: 0;
    --lit: 0;
    position: relative;
    width: min(100%, 380px);
    color: var(--on-sheet);
    cursor: pointer;
    perspective: 1100px;
    rotate: 3deg;
  }

  .id__inner {
    display: grid;
    transform: rotateY(calc(var(--tx) * 10deg)) rotateX(calc(var(--ty) * -8deg));
    transform-style: preserve-3d;
    transition: transform 0.75s var(--spring);
  }

  .id.is-flipped .id__inner {
    transform: rotateY(calc(180deg + var(--tx) * 10deg)) rotateX(calc(var(--ty) * 8deg));
  }

  .id__face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--c-ink);
    border-radius: 16px;
    background: var(--sheet);
    box-shadow: 0 30px 60px -32px rgb(12 13 33 / 0.6);
    backface-visibility: hidden;
  }

  .id__back {
    transform: rotateY(180deg);
  }

  .id__slot {
    align-self: center;
    width: 62px;
    height: 13px;
    margin: 13px 0 11px;
    border: 1px solid var(--c-ink);
    border-radius: 999px;
    background: var(--paper-2);
  }

  .id__back .id__bar {
    margin-top: 37px;
  }

  .id__bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 16px 10px;
    background: var(--cobalt);
    color: #ffffff;
    font: 600 semi-expanded 10.5px/1 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .id__body {
    display: grid;
    flex: 1;
    grid-template-columns: 42% 1fr;
    align-items: start;
    gap: 14px;
    padding: 16px;
  }

  .id__photo {
    overflow: hidden;
    border: 1px solid var(--c-ink);
    background: var(--periwinkle);
    aspect-ratio: 4 / 5;
  }

  .id__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .id__facts {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .id__row {
    margin: 0;
    padding: 10px 16px;
    border-top: 1px solid var(--sheet-line);
  }

  .id dt {
    color: var(--on-sheet-2);
    font: 600 semi-expanded 8.5px/1 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .id dd {
    margin: 4px 0 0;
    font-size: 14.5px;
    font-stretch: 92%;
    font-weight: 650;
    line-height: 1.2;
  }

  .id__courses {
    flex: 1;
    margin: 0;
    padding: 12px 16px 8px;
    counter-reset: course;
    list-style: none;
  }

  .id__courses li {
    display: grid;
    grid-template-columns: 3.4ch 1fr;
    padding: 3px 0;
    font-size: 13px;
    font-stretch: 92%;
    font-weight: 600;
    line-height: 1.25;
    counter-increment: course;
  }

  .id__courses li::before {
    content: counter(course, decimal-leading-zero);
    color: var(--on-sheet-2);
    font: 600 semi-expanded 8.5px/1.9 var(--font-label);
    letter-spacing: 0.08em;
  }

  .id__barcode {
    flex: none;
    height: 28px;
    margin: 4px 16px 14px;
    background: repeating-linear-gradient(
      90deg,
      var(--c-ink) 0 3px,
      transparent 3px 5px,
      var(--c-ink) 5px 6px,
      transparent 6px 9px,
      var(--c-ink) 9px 13px,
      transparent 13px 15px
    );
  }

  /* light sliding across the laminate */
  .id__glare {
    position: absolute;
    inset: 0;
    border-radius: 16px;
    background: radial-gradient(
      circle at calc(50% + var(--tx) * 50%) calc(50% + var(--ty) * 50%),
      rgb(255 255 255 / 0.5),
      transparent 55%
    );
    mix-blend-mode: soft-light;
    opacity: var(--lit);
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .id__flip {
    --key-bg: var(--bg);
    position: relative;
    z-index: 1;
  }

  .id__flip svg {
    transition: rotate 0.7s var(--spring);
  }

  .id__flip[aria-pressed='true'] svg {
    rotate: 180deg;
  }

  /* ── narrower: the board re-cuts itself ─── */
  @media (max-width: 1099px) {
    .board {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-areas:
        'say  say  say  say  say  say'
        'year year year grade grade grade'
        'id   id   id   more  more  more'
        'id   id   id   like  like  like'
        'bloom bloom bloom like like like';
    }

    .cell--bloom {
      min-height: 220px;
    }
  }

  @media (max-width: 699px) {
    .board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'say   say'
        'year  grade'
        'more  more'
        'id    id'
        'like  like'
        'bloom bloom';
    }

    /* two figures share a row here: sized so four digits fit in half the width */
    .figure {
      font-size: clamp(56px, 18.4vw, 132px);
    }

    .cell--bloom {
      min-height: 0;
      aspect-ratio: 2 / 1;
    }

    .bloom {
      width: 86%;
      margin: auto -14% -34% auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .id__inner {
      transition: none;
    }
  }
</style>
