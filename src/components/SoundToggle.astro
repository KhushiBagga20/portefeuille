---
// Sound on / off. Also gives every button on the site its key click.
---

<button class="tool sound" type="button" aria-pressed="true" data-sound-toggle>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M4 9.5h3.4L12 5.8v12.4l-4.6-3.7H4z" fill="currentColor"></path>
    <path class="sound__waves" d="M15.2 9.2a4 4 0 0 1 0 5.6M17.8 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"></path>
    <path class="sound__off" d="M15.5 9.5l5 5M20.5 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"></path>
  </svg>
  <span class="sr-only">Keyboard sounds</span>
</button>

<script>
  import { isSoundOn, keyDown, keyUp, onSoundChange, setSound, warmUp } from '../scripts/sound';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]');
  const sync = (on: boolean) =>
    buttons.forEach((b) => {
      b.setAttribute('aria-pressed', String(on));
      b.title = on ? 'Sounds on' : 'Sounds off';
    });
  sync(isSoundOn());
  onSoundChange(sync);

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      setSound(!isSoundOn());
      if (isSoundOn()) keyDown(0.9);
    }),
  );

  const onKeycap = (e: Event) => (e.target as Element | null)?.closest?.('.key');
  document.addEventListener('pointerdown', (e) => (warmUp(), onKeycap(e) && keyDown(0.9)), { passive: true });
  document.addEventListener('pointerup', (e) => onKeycap(e) && keyUp(), { passive: true });
</script>

<style>
  .sound[aria-pressed='true'] .sound__off,
  .sound[aria-pressed='false'] .sound__waves {
    display: none;
  }

  .sound[aria-pressed='false'] {
    color: var(--fg-2);
  }
</style>
