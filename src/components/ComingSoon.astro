---
// The only way missing details show up on the site: an honest "not written yet".
interface Props {
  text?: string;
}

const { text = 'details coming soon' } = Astro.props;
---

<span class="soon">{text}</span>

<style>
  .soon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 9px 4px;
    border: 1px dashed currentColor;
    font: 700 10px/1.3 var(--font-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .soon::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }
</style>
