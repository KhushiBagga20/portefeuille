---
// A 3.5" floppy with a typed label. Flat plastic, one thin line.
// Decorative: the text next to it carries the meaning.
import { diskTones, type DiskTone } from '../data/projects';

interface Props {
  tone: DiskTone;
  scribble: string;
  class?: string;
}

const { tone, scribble, class: className } = Astro.props;
const { body, shade } = diskTones[tone];
const dark = tone === 'mint';
---

<svg class:list={['disk', className]} viewBox="0 0 200 200" aria-hidden="true">
  <path
    d="M12 2 H172 L198 28 V188 Q198 198 188 198 H12 Q2 198 2 188 V12 Q2 2 12 2 Z"
    fill={body}
    stroke={dark ? '#f3f3ef' : '#0c0d21'}
    stroke-width="1.5"
    stroke-linejoin="round"></path>
  <path d="M8 191 H188 Q192 191 192 187 V34" fill="none" stroke={shade} stroke-width="6" stroke-linecap="square"></path>

  <rect x="72" y="10" width="46" height="50" fill="#0c0d21"></rect>
  <g class="disk__shutter">
    <rect x="50" y="2" width="104" height="66" fill="#dcdeea" stroke="#0c0d21" stroke-width="1.5"></rect>
    <rect x="112" y="13" width="24" height="44" fill="#0c0d21"></rect>
    <path d="M60 14 V56" stroke="#a9adc2" stroke-width="2"></path>
  </g>

  <rect x="22" y="88" width="156" height="100" fill="#ffffff" stroke="#0c0d21" stroke-width="1.5"></rect>
  <path d="M22 110 H178" stroke="#0c0d21" stroke-width="1.5"></path>
  <path d="M34 150 H166 M34 170 H166" stroke="#0c0d21" stroke-opacity="0.16" stroke-width="1"></path>
  <text class="disk__brand" x="30" y="103">HD · 1.44 MB</text>
  <text
    class="disk__scribble"
    x="100"
    y="146"
    textLength={scribble.length > 9 ? 136 : undefined}
    lengthAdjust="spacingAndGlyphs">{scribble}</text
  >

  <rect x="10" y="172" width="9" height="13" fill={dark ? '#f3f3ef' : '#0c0d21'}></rect>
</svg>

<style>
  .disk {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .disk__shutter {
    transition: transform 0.55s var(--spring);
  }

  .disk__brand {
    fill: #0c0d21;
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  /* a typed label, the way you'd run one through a label maker */
  .disk__scribble {
    fill: #0c0d21;
    font-family: var(--font-mono);
    font-size: 21px;
    font-weight: 500;
    text-anchor: middle;
  }
</style>
