---
// Day / night. A half-moon that turns over.
// Only the neutral paper flips — the coloured posters are the same at midnight.
---

<button class="tool mode" type="button" role="switch" aria-checked="false" data-mode>
  <span class="sr-only">Night mode</span>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
  </svg>
</button>

<script>
  const KEY = 'khushi:mode';
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-mode]');

  const paint = (night: boolean) => {
    root.dataset.theme = night ? 'night' : 'day';
    buttons.forEach((b) => {
      b.setAttribute('aria-checked', String(night));
      b.title = night ? 'Night — switch to day' : 'Day — switch to night';
    });
    document.querySelector('meta[name="theme-color"]:not([data-fixed])')?.setAttribute('content', night ? '#0f1028' : '#f3f3ef');
  };

  paint(root.dataset.theme === 'night');

  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const night = root.dataset.theme !== 'night';
      // animate the colour change on a deliberate flip, never on load
      root.classList.add('is-switching');
      paint(night);
      try {
        localStorage.setItem(KEY, night ? 'night' : 'day');
      } catch {}
      window.setTimeout(() => root.classList.remove('is-switching'), 650);
    }),
  );
</script>

<style>
  .mode svg {
    transition: rotate 0.6s var(--spring);
  }

  .mode[aria-checked='true'] svg {
    rotate: 180deg;
  }
</style>
