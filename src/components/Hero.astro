---
// The cover. A masthead the width of the page, a portrait standing in front of it, and
// one large flower turning behind — laid out like the front of a magazine.
//
// The collage and its three scroll acts live in Collage.astro and scripts/hero.ts and are
// untouched; this file only decides where everything sits around them.
import Arrow from './Arrow.astro';
import Collage from './Collage.astro';
import Rosette from './Rosette.astro';
import { chapter } from '../data/chapters';
import { site } from '../data/site';

const c = chapter('top');
const letters = [...site.name.toUpperCase()];
const [first, ...rest] = site.headline.split(', ');
const now = site.currently.replace(/^currently:\s*/i, '');
---

<section id="top" class="hero s-paper" data-hero {...c.attrs} aria-labelledby="hero-title">
  <div class="stage" data-stage data-act="1" data-kinetic>
    <div class="lines" aria-hidden="true"></div>

    <div class="mast-box">
      <h1 id="hero-title" class="mast">
        <span class="mast__word" aria-hidden="true">
          {letters.map((ch, i) => <span class="mast__l" data-k={i} style={`--i:${i}`}>{ch}</span>)}
        </span>
        <span class="sr-only">{site.name} ({site.fullName})</span>
      </h1>
      <p class="hello" aria-hidden="true">{site.hello}</p>
    </div>

    <div class="bloom" aria-hidden="true">
      <Rosette
        rings={[
          { n: 16, at: 74, r: 15.5, fill: 'var(--marigold)', rate: 1 },
          { n: 11, at: 47, r: 15, fill: 'var(--marigold-pale)', rate: -1.5 },
          { n: 7, at: 23, r: 12.5, fill: 'var(--marigold-deep)', rate: 2.4 },
        ]}
        core={{ r: 8.5, fill: 'var(--signal)' }}
      />
    </div>

    <div class="art">
      <Collage />

      <p class="fig" aria-hidden="true">
        <span class="fig__no">fig. {c.index}</span>
        <span class="fig__caps voice">
          <span data-caption="1">me, drawn</span>
          <span data-caption="2">me, for real</span>
          <span data-caption="3">usually both at once</span>
        </span>
      </p>

      <div class="acts" role="group" aria-label="Collage view">
        <button class="key key--sm" type="button" data-act-to="0" aria-pressed="true">drawn</button>
        <button class="key key--sm" type="button" data-act-to="0.7" aria-pressed="false">real</button>
        <button class="key key--sm" type="button" data-act-to="1" aria-pressed="false">both</button>
      </div>
    </div>

    <!-- the same masthead again, as an outline, so the name still reads across the portrait -->
    <div class="mast-box mast-box--ghost" aria-hidden="true">
      <p class="mast">
        <span class="mast__word">
          {letters.map((ch, i) => <span class="mast__l" data-k={i} style={`--i:${i}`}>{ch}</span>)}
        </span>
      </p>
    </div>

    <div class="copy">
      <p class="headline">
        <span class="headline__a">{first},</span>
        <span class="headline__b voice">{rest.join(', ')}</span>
      </p>
      <p class="intro">{site.intro}</p>

      <dl class="facts">
        <div>
          <dt>who</dt>
          <dd>{site.fullName}</dd>
        </div>
        <div>
          <dt>what</dt>
          <dd>{site.tag} · {site.program}</dd>
        </div>
        <div>
          <dt>now</dt>
          <dd><i class="facts__dot" aria-hidden="true"></i>{now}</dd>
        </div>
      </dl>

      <div class="cta">
        <a class="key key--solid" href="#projects">see the work <Arrow dir="down" /></a>
        <a class="key" href="#contact">say hi</a>
      </div>
    </div>

    <div class="foot" aria-hidden="true">
      <span class="foot__scroll">scroll<i></i></span>
      <span class="foot__acts">
        <span data-act-name="1">act 1/3 — look closer</span>
        <span data-act-name="2">act 2/3 — open up</span>
        <span data-act-name="3">act 3/3 — swap</span>
      </span>
      <span class="foot__bar"></span>
    </div>
  </div>
</section>

<script>
  import { initHero } from '../scripts/hero';
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach(initHero);
</script>

<style>
  .hero {
    position: relative;
    height: 300svh;
    background: var(--bg);
    color: var(--fg);
  }

  .stage {
    --p: 0;
    --mx: 0;
    --my: 0;
    /* where the portrait stands: the flower and the caption are placed from the same numbers */
    --art-w: min(30vw, calc((100svh - var(--bar) - 13svh - 60px) * 0.8), 500px);
    --art-right: calc(var(--gutter) + 6vw);
    --art-top: calc(var(--bar) + 5svh);
    --pad-top: calc(var(--bar) + clamp(10px, 2.4svh, 28px));
    position: sticky;
    top: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100svh;
    padding: var(--pad-top) var(--gutter) clamp(14px, 2.4svh, 26px);
    overflow: clip;
  }

  /* the poster grid: big square modules, hairline */
  .lines {
    --cell: calc((100% - 2 * var(--gutter)) / 6);
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(90deg, var(--line) 1px, transparent 1px),
      linear-gradient(var(--line) 1px, transparent 1px);
    background-position: var(--gutter) var(--bar);
    background-size: var(--cell) var(--cell);
    opacity: 0.55;
    pointer-events: none;
  }

  /* ── masthead ───────────────────────── */
  .mast-box {
    position: relative;
    z-index: 1;
    container-type: inline-size;
  }

  .mast-box--ghost {
    position: absolute;
    top: var(--pad-top);
    right: var(--gutter);
    left: var(--gutter);
    z-index: 4;
    pointer-events: none;
    /* only where the portrait is: anywhere else the outline would nibble at the solid letters */
    clip-path: inset(
      0 calc(var(--art-right) - var(--gutter) - 14px) 0 calc(100% - var(--art-right) + var(--gutter) - var(--art-w) - 14px)
    );
  }

  .mast {
    margin: 0;
    font-family: var(--font-display);
    /* the word is 4.423em wide at full width and weight, so this fills the measure exactly */
    font-size: calc(100cqw / 4.44);
    font-weight: 900;
    line-height: 0.76;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .mast__word {
    display: block;
  }

  .mast__l {
    display: inline-block;
    font-variation-settings: 'wdth' var(--w, 100);
    transition: font-variation-settings 0.45s var(--ease-out);
  }

  .mast-box--ghost .mast__l {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--bg);
  }

  /* the greeting is knocked out of the K's own stem, reading down it */
  .hello {
    position: absolute;
    top: 2.2cqw;
    left: 3.25cqw;
    margin: 0;
    color: var(--bg);
    font: 500 clamp(8px, 0.98cqw, 14px) / 1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    writing-mode: vertical-rl;
  }

  /* ── the flower ─────────────────────── */
  .bloom {
    --d: min(60svh, 44vw, calc(var(--art-w) * 1.28));
    --spin: calc(var(--p) * 210deg + var(--mx) * 16deg);
    position: absolute;
    top: calc(var(--art-top) + var(--art-w) * 1.25 * 0.8 - var(--d) / 2);
    right: calc(var(--art-right) + var(--art-w) * 0.8 - var(--d) / 2);
    z-index: 2;
    width: var(--d);
    mix-blend-mode: multiply;
    scale: calc(1 + var(--p) * 0.3);
    translate: calc(var(--mx) * -10px) calc(var(--my) * -8px);
    pointer-events: none;
  }

  :global([data-theme='night']) .bloom {
    mix-blend-mode: normal;
  }

  /* ── the portrait ───────────────────── */
  .art {
    position: absolute;
    top: var(--art-top);
    right: var(--art-right);
    z-index: 3;
    width: var(--art-w);
  }

  .fig {
    position: absolute;
    top: 47%;
    left: calc(100% + 18px);
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0;
    white-space: nowrap;
    writing-mode: vertical-rl;
  }

  .fig__no {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .fig__caps {
    position: relative;
    font-size: clamp(16px, 1.3vw, 21px);
    line-height: 1;
  }

  .fig__caps span {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    translate: 0 10px;
    transition:
      opacity 0.3s ease,
      translate 0.5s var(--ease-out);
  }

  .fig__caps span:first-child {
    position: relative;
  }

  .stage[data-act='1'] [data-caption='1'],
  .stage[data-act='2'] [data-caption='2'],
  .stage[data-act='3'] [data-caption='3'] {
    opacity: 1;
    translate: 0 0;
  }

  /* With reduced motion the collage doesn't play on scroll; these flip between its three states instead. */
  .acts {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .acts {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 18px;
    }

    .acts .key[aria-pressed='true'] {
      --key-bg: var(--fg);
      --key-fg: var(--bg);
    }
  }

  /* ── copy ───────────────────────────── */
  .copy {
    position: relative;
    z-index: 5;
    align-self: end;
    width: min(44%, 620px);
    padding-bottom: clamp(8px, 2svh, 26px);
  }

  .headline {
    margin: 0;
    font-size: clamp(38px, 5.1vw, 86px);
    line-height: 0.9;
  }

  .headline__a {
    display: block;
    font-family: var(--font-display);
    font-stretch: 66%;
    font-weight: 800;
    letter-spacing: -0.012em;
    text-transform: uppercase;
  }

  /* the second line is set light and sized so both lines come out the same width */
  .headline__b {
    display: block;
    margin-top: 0.1em;
    font-size: 0.896em;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .intro {
    max-width: 34ch;
    margin: clamp(12px, 2svh, 22px) 0 0;
    color: var(--fg-2);
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.45;
  }

  .facts {
    display: grid;
    gap: 5px;
    margin: clamp(12px, 2.2svh, 24px) 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .facts div {
    display: grid;
    grid-template-columns: 6ch 1fr;
  }

  .facts dt {
    color: var(--fg-2);
  }

  .facts dd {
    margin: 0;
  }

  .facts__dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--signal);
    animation: blink 1.6s steps(2, jump-none) infinite;
  }

  @keyframes blink {
    to {
      opacity: 0.15;
    }
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(14px, 2.6svh, 28px);
  }

  /* ── foot of the cover ──────────────── */
  .foot {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 10px;
    color: var(--fg-2);
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .foot__scroll {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    opacity: calc(1 - var(--p) * 12);
  }

  .foot__scroll i {
    width: 44px;
    height: 1px;
    background: currentColor;
    transform-origin: left;
    animation: reach 1.8s var(--ease-in-out) infinite;
  }

  @keyframes reach {
    0% {
      scale: 0 1;
    }
    60%,
    100% {
      scale: 1 1;
    }
    100% {
      opacity: 0;
    }
  }

  .foot__acts {
    position: relative;
    display: grid;
    justify-items: end;
  }

  .foot__acts span {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .stage[data-act='1'] [data-act-name='1'],
  .stage[data-act='2'] [data-act-name='2'],
  .stage[data-act='3'] [data-act-name='3'] {
    opacity: 1;
  }

  /* how far through the three acts you are */
  .foot__bar {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--line);
  }

  .foot__bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--fg);
    transform-origin: left;
    scale: var(--p) 1;
  }

  /* ── entrance (JS only) ─────────────── */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .stage:not(.is-ready) .mast__l,
    :global(.js) .stage:not(.is-ready) .hello,
    :global(.js) .stage:not(.is-ready) .bloom,
    :global(.js) .stage:not(.is-ready) .copy > * {
      opacity: 0;
    }

    .stage.is-ready .mast__l {
      animation: rise 0.95s var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 65ms);
    }

    .stage.is-ready .hello {
      animation: sign 0.7s var(--ease-out) 0.55s backwards;
    }

    .stage.is-ready .bloom {
      animation: bloom 1.3s var(--spring) 0.25s backwards;
    }

    .stage.is-ready .copy > * {
      animation: lift 0.8s var(--ease-out) backwards;
    }

    .stage.is-ready .copy > :nth-child(1) {
      animation-delay: 0.35s;
    }
    .stage.is-ready .copy > :nth-child(2) {
      animation-delay: 0.43s;
    }
    .stage.is-ready .copy > :nth-child(3) {
      animation-delay: 0.51s;
    }
    .stage.is-ready .copy > :nth-child(4) {
      animation-delay: 0.59s;
    }

    @keyframes rise {
      from {
        opacity: 0;
        translate: 0 0.42em;
      }
    }

    @keyframes sign {
      from {
        opacity: 0;
        translate: -12px 8px;
      }
    }

    @keyframes bloom {
      from {
        opacity: 0;
        scale: 0.2;
        rotate: -80deg;
      }
    }

    @keyframes lift {
      from {
        opacity: 0;
        translate: 0 22px;
      }
    }
  }

  /* ── phones & small tablets ─────────────
     Not a shrunk desktop: the masthead runs across the top, the portrait stands
     in front of its last letters, and the words stack underneath. */
  @media (max-width: 899px) {
    .hero {
      height: 250svh;
    }

    .stage {
      --art-w: min(68vw, calc((100svh - var(--bar) - 318px) * 0.8), 420px);
      --art-right: calc(var(--gutter) + 2vw);
      --art-top: calc(var(--bar) + 14px + 9vw);
      --pad-top: calc(var(--bar) + 12px);
    }

    .bloom {
      --d: min(calc(var(--art-w) * 1.2), 78vw);
    }

    .copy {
      width: 100%;
      padding-bottom: 4px;
    }

    .headline {
      font-size: clamp(34px, 10.4vw, 64px);
    }

    .intro,
    .facts,
    .lines {
      display: none;
    }

    .fig {
      display: none;
    }

    /* the stem is too thin to print in at this size */
    .hello {
      display: none;
    }

    .foot__scroll {
      display: none;
    }
  }

  @media (max-width: 899px) and (min-height: 760px) {
    .facts {
      display: grid;
    }
  }

  /* Very short screens (landscape phones): no pinning, just a calm static layout. */
  @media (max-height: 540px) {
    .hero {
      height: auto;
    }

    .stage {
      --art-w: min(30vw, 300px);
      position: relative;
      height: auto;
      min-height: 100svh;
    }

    .copy {
      padding-top: 46vw;
    }

    .foot {
      display: none;
    }
  }

  @media (max-height: 540px) and (min-width: 900px) {
    .copy {
      padding-top: 30vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }

    .stage {
      position: relative;
      height: auto;
      min-height: 100svh;
    }

    .foot__acts,
    .foot__bar {
      display: none;
    }
  }
</style>
