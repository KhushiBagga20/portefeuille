---
// The strip that runs along the top of every poster: index, name, a hairline, and one
// true annotation about what's below.
//
// On the main page pass a chapter `id` and the number comes from the running order.
// Anywhere else (the Playground's rooms, case studies) pass `index` and `name` directly.
import { chapter, type ChapterId } from '../data/chapters';

interface Props {
  id?: ChapterId;
  index?: string;
  name?: string;
  note?: string;
  class?: string;
}
const { id, note, class: className } = Astro.props;
const c = id ? chapter(id) : undefined;
const index = Astro.props.index ?? c?.index ?? '';
const name = Astro.props.name ?? c?.name ?? '';
---

<div class:list={['ph', className]}>
  {index && <span class="ph__idx">({index})</span>}
  <span class="ph__name">{name}</span>
  <span class="ph__rule" aria-hidden="true"></span>
  {note && <span class="ph__note">{note}</span>}
</div>

<style>
  .ph {
    display: flex;
    align-items: center;
    gap: 14px;
    font: 700 11px/1.3 var(--font-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* the index and the annotation are the machine's voice */
  .ph__idx,
  .ph__note {
    font: 500 12px/1.3 var(--font-mono);
    letter-spacing: 0;
    text-transform: none;
  }

  .ph__rule {
    flex: 1;
    height: 1px;
    background: var(--line);
    transform-origin: left;
  }

  .ph__note {
    color: var(--fg-2);
    text-align: right;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ph__rule {
      scale: 0 1;
      transition: scale 1.1s var(--ease-out) 0.1s;
    }

    :global(.js .is-seen) .ph__rule,
    :global(.js .is-arrived) .ph__rule,
    :global(.js .play) .ph__rule {
      scale: 1 1;
    }
  }

  @media (max-width: 599px) {
    .ph {
      gap: 10px;
      font-size: 10px;
    }

    .ph__idx,
    .ph__note {
      font-size: 11px;
    }
  }
</style>
