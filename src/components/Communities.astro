---
// Beyond projects: the clubs. Two names set as large as the page allows, the facts beside.
import PosterHead from './PosterHead.astro';
import { chapter } from '../data/chapters';
import { communities } from '../data/profile';

const c = chapter('experience');
---

<section id="experience" class="beyond poster s-paper" {...c.attrs} aria-labelledby="experience-title">
  <div class="wrap">
    <PosterHead id="experience" note="communities & roles" />
    <h2 id="experience-title" class="sr-only">Beyond projects</h2>

    <ul class="clubs">
      {
        communities.map((club, i) => (
          <li class="club" data-reveal style={`--i:${i}`}>
            <h3 class="club__name">{club.name}</h3>
            <div class="club__facts">
              <p class="club__role">{club.role}</p>
              <p class="label label--dim">
                {club.org}
                {club.since && <Fragment> · {club.since}</Fragment>}
              </p>
              <p class="club__line">{club.line}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .beyond {
    padding-bottom: clamp(40px, 6vw, 90px);
  }

  .clubs {
    margin: clamp(22px, 3vw, 44px) 0 0;
    padding: 0;
    list-style: none;
  }

  .club {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(16px, 4vw, 70px);
    padding: clamp(14px, 2vw, 26px) 0 clamp(16px, 2.2vw, 30px);
    border-bottom: 1px solid var(--line);
  }

  /* drawn in outline until you reach for it */
  .club__name {
    margin: 0;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(58px, 13.6vw, 250px);
    font-stretch: 62%;
    font-weight: 900;
    line-height: 0.78;
    letter-spacing: -0.012em;
    text-transform: uppercase;
    -webkit-text-stroke: 1.5px var(--fg);
    transition:
      color 0.35s ease,
      font-stretch 0.6s var(--ease-out);
  }

  .club:hover .club__name {
    color: var(--accent);
    font-stretch: 72%;
    -webkit-text-stroke-color: var(--accent);
  }

  .club__facts {
    padding-bottom: 0.4em;
  }

  .club__role {
    margin: 0 0 8px;
    font-size: clamp(20px, 1.9vw, 30px);
    font-stretch: 84%;
    font-weight: 700;
    line-height: 1.05;
  }

  .club__line {
    max-width: 36ch;
    margin: 12px 0 0;
    color: var(--fg-2);
    line-height: 1.45;
  }

  @media (max-width: 699px) {
    .club {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (hover: none) {
    .club__name {
      color: var(--fg);
    }
  }
</style>
