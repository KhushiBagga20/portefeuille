---
// The Playground's page shell: its own bar, a dark page from edge to edge, and at the foot
// the two ways on — the next room, or back up to the portfolio.
import Base from './Base.astro';
import Arrow from '../components/Arrow.astro';
import PlayNav from '../components/PlayNav.astro';
import { playground, rooms, type RoomId } from '../data/playground';
import { site } from '../data/site';

interface Props {
  here: RoomId | 'hub';
  title: string;
  description: string;
  /** leave the foot off for rooms that fill the screen and manage their own way out */
  foot?: boolean;
}
const { here, title, description, foot = true } = Astro.props;

const i = rooms.findIndex((r) => r.id === here);
const next = here === 'hub' ? rooms[0] : rooms[(i + 1) % rooms.length];
const prev = here === 'hub' ? undefined : rooms[(i - 1 + rooms.length) % rooms.length];
---

<Base title={`${title} · ${site.fullName}`} description={description} bodyClass="play" themeColor="#0c0d21">
  <PlayNav here={here} />
  <main class="play">
    <slot />
  </main>

  {
    foot && (
      <footer class="pfoot s-play">
        <a class="pfoot__way pfoot__way--back" href="/">
          <span class="pfoot__k">exit</span>
          <span class="pfoot__v">
            <Arrow dir="left" /> the portfolio
          </span>
        </a>
        {prev && (
          <a class="pfoot__way" href={prev.href} style={`--room:${prev.accent}`}>
            <span class="pfoot__k">room {prev.no}</span>
            <span class="pfoot__v">
              <Arrow dir="left" /> {prev.name}
            </span>
          </a>
        )}
        {here !== 'hub' && (
          <a class="pfoot__way" href={playground.href} style="--room:var(--play)">
            <span class="pfoot__k">all rooms</span>
            <span class="pfoot__v">{playground.name}</span>
          </a>
        )}
        <a class="pfoot__way pfoot__way--next" href={next.href} style={`--room:${next.accent}`}>
          <span class="pfoot__k">{here === 'hub' ? 'start in' : 'next'} · room {next.no}</span>
          <span class="pfoot__v">
            {next.name} <Arrow />
          </span>
        </a>
      </footer>
    )
  }
</Base>

<style>
  .play {
    display: block;
    padding-top: var(--bar);
  }

  /* the ways out, as doors along the foot of the room */
  .pfoot {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    border-top: 1px solid var(--line);
    background: var(--bg);
    color: var(--fg);
  }

  .pfoot__way {
    --room: var(--c-paper);
    position: relative;
    display: grid;
    gap: 10px;
    padding: clamp(18px, 2.4vw, 34px) var(--gutter) clamp(20px, 2.6vw, 38px);
    text-decoration: none;
    isolation: isolate;
    transition: color 0.3s var(--ease-out);
  }

  .pfoot__way + .pfoot__way {
    border-left: 1px solid var(--line);
  }

  .pfoot__way::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--room);
    scale: 1 0;
    transform-origin: bottom;
    transition: scale 0.45s var(--ease-out);
  }

  .pfoot__k {
    color: var(--fg-2);
    font: 500 12px/1 var(--font-mono);
    transition: color 0.3s var(--ease-out);
  }

  .pfoot__v {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font: 400 clamp(20px, 2.4vw, 38px) / 1 var(--font-head);
    letter-spacing: -0.03em;
  }

  .pfoot__way--next {
    text-align: right;
  }

  .pfoot__way--next .pfoot__v {
    justify-content: flex-end;
  }

  @media (hover: hover) {
    .pfoot__way:hover {
      color: #0c0d21;
    }

    .pfoot__way:hover .pfoot__k {
      color: #0c0d21;
    }

    .pfoot__way:hover::before {
      scale: 1 1;
    }
  }

  @media (max-width: 799px) {
    .pfoot {
      grid-auto-flow: row;
      grid-template-columns: 1fr 1fr;
    }

    .pfoot__way--next {
      grid-column: 1 / -1;
      order: -1;
      border-bottom: 1px solid var(--line);
      text-align: left;
    }

    .pfoot__way--next .pfoot__v {
      justify-content: flex-start;
      font-size: 34px;
    }

    .pfoot__way + .pfoot__way {
      border-left: 0;
    }

    .pfoot__way:nth-child(even) {
      border-left: 1px solid var(--line);
    }

    .pfoot__way:not(.pfoot__way--next):nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
</style>
