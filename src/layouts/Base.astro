---
// Four faces, one job each (see styles/global.css). The subsets carry unicode ranges, so a
// browser only downloads the files a page actually uses.
import '@fontsource/anton/400.css';
import '@fontsource/archivo-black/400.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
// The three that set the first screen are worth fetching before the CSS asks for them.
import anton from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import archivoBlack from '@fontsource/archivo-black/files/archivo-black-latin-400-normal.woff2?url';
import manrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { site } from '../data/site';
import { about, education } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** a class for <body>: the Playground uses it to turn the whole page dark */
  bodyClass?: string;
  themeColor?: string;
}

const { title = site.title, description = site.description, noindex = false, bodyClass, themeColor = '#f3f3ef' } = Astro.props;

// Absolute URLs need `site` in astro.config.mjs (set it once the domain exists).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  ...(Astro.site && { url: Astro.site.href }),
  email: site.links.email ? `mailto:${site.links.email}` : undefined,
  sameAs: [site.links.linkedin, site.links.github].filter(Boolean),
  affiliation: { '@type': 'CollegeOrUniversity', name: education.school },
  knowsAbout: about.interests,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="theme-color" content={themeColor} data-fixed={themeColor !== '#f3f3ef' ? '' : undefined} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {[archivoBlack, anton, manrope].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.fullName}: ${site.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Daylight is the design. Night only if this visitor has flipped the switch before.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('khushi:mode');
        } catch {}
        document.documentElement.dataset.theme = saved === 'night' ? 'night' : 'day';
      })();
      // Name the kind of page change, so the stylesheet can stage it: going down into the
      // Playground, coming back up, or walking from one room to the next.
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        try {
          const inPlay = (path) => path.startsWith('/playground');
          const from = document.referrer ? new URL(document.referrer) : null;
          if (!from || from.origin !== location.origin) return;
          const was = inPlay(from.pathname);
          const is = inPlay(location.pathname);
          e.viewTransition.types.add(is && !was ? 'dive' : was && !is ? 'surface' : is ? 'room' : 'page');
        } catch {}
      });
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body class={bodyClass}>
    <slot />

    <!-- the card that wipes across when you jump between sections -->
    <div class="jump" data-jump aria-hidden="true">
      <span class="jump__idx" data-jump-idx></span>
      <span class="jump__line"><span class="jump__name" data-jump-name></span></span>
    </div>

    <script>
      import '../scripts/fx';
    </script>
  </body>
</html>
