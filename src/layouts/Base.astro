---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
// The masthead is set in this file at 20vw, so it's worth fetching before the CSS asks for it.
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { site } from '../data/site';
import { about, education } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;

// Absolute URLs need `site` in astro.config.mjs (set it once the domain exists).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  ...(Astro.site && { url: Astro.site.href }),
  email: site.links.email ? `mailto:${site.links.email}` : undefined,
  sameAs: [site.links.linkedin, site.links.github].filter(Boolean),
  affiliation: { '@type': 'CollegeOrUniversity', name: education.school },
  knowsAbout: about.interests,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="theme-color" content="#f3f3ef" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.fullName}: ${site.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Daylight is the design. Night only if this visitor has flipped the switch before.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('khushi:mode');
        } catch {}
        document.documentElement.dataset.theme = saved === 'night' ? 'night' : 'day';
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <slot />

    <!-- the card that wipes across when you jump between sections -->
    <div class="jump" data-jump aria-hidden="true">
      <span class="jump__idx" data-jump-idx></span>
      <span class="jump__name" data-jump-name></span>
    </div>

    <script>
      import '../scripts/fx';
    </script>
  </body>
</html>
