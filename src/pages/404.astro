---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Arrow from '../components/Arrow.astro';
import FloppyDisk from '../components/FloppyDisk.astro';
import { site } from '../data/site';
---

<Base title={`Disk not found · ${site.fullName}`} noindex>
  <Nav here="error" />
  <main class="lost poster s-ink">
    <p class="lost__code" aria-hidden="true">404</p>

    <section class="lost__body" aria-labelledby="lost-title">
      <p class="label">error 404</p>
      <h1 id="lost-title" class="lost__title">Disk not<br />found.</h1>
      <p class="lost__text">This page isn't on any of my disks. It may have moved, or it never existed.</p>
      <div class="lost__actions">
        <a class="key key--accent" href="/">take me home <Arrow /></a>
        <a class="key" href="/#projects">see the work</a>
      </div>
    </section>

    <div class="lost__disk" aria-hidden="true">
      <FloppyDisk tone="lemon" scribble="???" />
    </div>
  </main>
</Base>

<style>
  .lost {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 32px;
    min-height: 100svh;
    padding-top: calc(var(--bar) + 40px);
    overflow: clip;
  }

  /* the number, outlined, too big for the page on purpose */
  .lost__code {
    position: absolute;
    top: calc(var(--bar) - 0.02em);
    left: calc(var(--gutter) - 0.03em);
    margin: 0;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(220px, 46vw, 860px);
    font-weight: 400;
    line-height: 0.94;
    -webkit-text-stroke: 1.5px var(--fg-2);
    pointer-events: none;
  }

  .lost__body {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(8px, 2vw, 30px);
  }

  .lost__title {
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-size: clamp(56px, 9.6vw, 180px);
    font-weight: 400;
    line-height: 0.94;
    text-transform: uppercase;
  }

  .lost__text {
    max-width: 34ch;
    margin: clamp(16px, 2vw, 28px) 0 0;
    color: var(--fg-2);
    font-size: clamp(17px, 1.4vw, 21px);
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .lost__disk {
    position: relative;
    z-index: 1;
    width: clamp(150px, 22vw, 320px);
    margin-bottom: clamp(8px, 2vw, 30px);
    rotate: -9deg;
    animation: wobble 3.2s ease-in-out infinite alternate;
  }

  @keyframes wobble {
    to {
      rotate: 6deg;
      translate: 0 -8px;
    }
  }

  @media (max-width: 699px) {
    .lost {
      grid-template-columns: minmax(0, 1fr);
      align-content: end;
    }

    .lost__disk {
      order: -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lost__disk {
      animation: none;
    }
  }
</style>
