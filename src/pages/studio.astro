---
import '@fontsource/anton/400.css';
import '@fontsource-variable/manrope/wght.css';
const api = import.meta.env.PUBLIC_API_ORIGIN || (import.meta.env.DEV ? 'http://localhost:8000' : '');
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>Portfolio Studio · Khushi</title></head>
<body>
<main id="studio" data-api={api}>
  <header><a href="/">← Portfolio</a><span>YOUR PRIVATE EDITOR</span></header>
  <section class="intro"><p class="eyebrow">PORTFOLIO STUDIO</p><h1>REVIEW. THEN PUBLISH.</h1><p>GitHub creates private drafts. You decide what goes on your website.</p></section>
  <div id="notice" role="status" aria-live="polite">Connecting…</div>
  <section id="login" hidden class="panel"><h2>Sign in to your studio</h2><p>Use your GitHub account to review drafts and publish your work.</p><a id="login-link" class="button">Sign in with GitHub ↗</a></section>
  <section id="workspace" hidden>
    <nav class="toolbar" aria-label="Studio controls"><label>Project<select id="project"></select></label><button id="refresh" class="quiet">Refresh status</button><a id="live-link" target="_blank" rel="noopener noreferrer">Open website ↗</a><button id="logout" class="quiet">Sign out</button></nav>
    <div class="status-grid" aria-label="Publication status">
      <section class="status-card"><p class="eyebrow">PUBLISHED CONTENT</p><h2 id="version">Checking…</h2><p class="hint">The last version you approved.</p></section>
      <section class="status-card"><p class="eyebrow">YOU ARE REVIEWING</p><h2 id="draft-state">Checking…</h2><p id="draft-detail" class="hint"></p></section>
      <section class="status-card"><p class="eyebrow">PUBLIC WEBSITE</p><h2 id="website-state">Checking…</h2><p id="website-detail" class="hint">Comparing the website with your published content.</p></section>
    </div>
    <div class="columns">
      <section class="panel review-panel">
        <p class="eyebrow">1 / REVIEW YOUR DRAFT</p><h2 id="preview-title">Your case study</h2>
        <p><a href="#publish-controls">Go to publish controls ↓</a></p><div class="draft-picker"><button id="latest-draft">Review latest ready draft</button><details><summary>Choose another draft or published version</summary><label>Version to review<select id="revision"></select></label></details></div>
        <p id="change-summary" class="hint"></p>
        <div id="preview"></div>
        <details><summary>Questions for you · private</summary><div id="review-notes" class="hint"></div></details>
        <details><summary>Source links &amp; files inspected · private</summary><div id="source-review" class="hint"></div></details>
        <details><summary>Edit the full draft · advanced</summary><p class="hint">Editing here changes only your draft. Save changes before publishing.</p><label>Case-study content<textarea id="content" rows="18" spellcheck="false"></textarea></label></details>
        <div id="publish-controls" class="publish-box"><p class="eyebrow">2 / PUBLISH WHEN YOU ARE READY</p><p id="action-help"></p><div class="actions"><button id="save" class="quiet">Save changes</button><button id="publish" disabled>Publish this draft</button></div><p class="hint">Publishing saves the approved version and starts a website rebuild. The website status above confirms when it is live.</p></div>
      </section>
      <aside class="panel">
        <p class="eyebrow">GITHUB CONNECTION</p><h2>Prepare the next draft</h2><p class="hint">Already have a draft to review? You do not need to generate it again.</p><div id="repository-scans"></div>
        <section class="activity"><h3>Recent activity</h3><div id="jobs"></div><p class="hint">Status updates automatically. Your edits and selected draft stay in place.</p></section>
        <details><summary>Write a short update yourself</summary><label>Update title<input id="update-title" placeholder="What changed?"/></label><label>Update details<textarea id="update-body" rows="5" placeholder="What you built or learned."></textarea></label><button id="append" class="quiet">Add to this draft</button></details>
        <details><summary>Draft a short update from selected activity</summary><p class="hint">This creates a short update, not a full case study.</p><div id="evidence"></div><button id="generate" class="quiet">Generate short update</button></details>
        <details><summary>Connect another repository · advanced</summary><form id="repo-form"><label>Repository ID<input id="repo-id" required pattern="[0-9]+"/></label><label>Repository name<input id="repo-name" required placeholder="owner/repository"/></label><label class="check"><input id="repo-ai" type="checkbox"/> Allow selected descriptions to be sent to AI</label><button type="submit" class="quiet">Connect repository</button></form></details>
        <details><summary>Published version history</summary><div id="history"></div></details>
      </aside>
    </div>
  </section>
  <footer>Drafts stay private until you publish. Source notes and questions are never published.</footer>
</main>
<script src="../scripts/studio.ts"></script>
</body>
</html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#efeee8;color:#17182c;font-family:'Manrope Variable',sans-serif}:global([hidden]){display:none!important}main{max-width:1440px;margin:auto;padding:25px 4vw}header{display:flex;justify-content:space-between;border-bottom:1px solid #ccc;padding-bottom:18px;font-size:12px;letter-spacing:.06em}a{color:inherit}header a{text-decoration:none}.intro{padding:25px 0 14px}h1{font-family:Anton,sans-serif;font-size:clamp(34px,5vw,64px);font-weight:400;line-height:1.05;margin:12px 0}.intro>p:last-child{font-size:15px}.eyebrow{font-size:10px;font-weight:800;letter-spacing:.13em}h2{font-size:22px;margin:8px 0 14px}h3{font-size:16px}#notice{padding:14px 18px;border:1px solid #c1c2b8;margin:12px 0 20px;background:#faffdc;overflow-wrap:anywhere;font-size:14px}.panel{background:#fafaf5;padding:25px;border:1px solid #d2d2ca;min-width:0}.columns{display:grid;grid-template-columns:minmax(0,1.9fr) minmax(260px,1fr);gap:20px}.toolbar{display:flex;align-items:center;gap:16px;margin-bottom:20px;flex-wrap:wrap}.toolbar label{min-width:220px;margin:0}.toolbar a{font-size:13px}.toolbar #logout{margin-left:auto}.status-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:22px}.status-card{border:1px solid #ccc;background:#fafaf5;padding:17px 20px}.status-card h2{font-size:20px;margin:7px 0}.status-card p{margin:5px 0}.status-card:nth-child(2){background:#e6eedc}label{display:block;font-size:12px;font-weight:700;margin:14px 0}input:not([type=checkbox]),select,textarea{display:block;width:100%;margin-top:7px;padding:11px;background:white;border:1px solid #aaa;border-radius:4px;color:#17182c;font:inherit}textarea{resize:vertical;line-height:1.5}#content{font-family:monospace;font-size:12px}:global(button),.button{display:inline-block;padding:12px 16px;background:#17182c;color:#fafaf5;border:1px solid #17182c;border-radius:4px;font:inherit;font-size:12px;font-weight:700;text-decoration:none;cursor:pointer}.quiet{background:transparent;color:#17182c}:global(button:disabled){opacity:.45;cursor:not-allowed}:global(button:hover:not(:disabled)),.button:hover{background:#d94b29;color:white}.hint{font-size:12px;line-height:1.65;color:#5b5d65}.actions{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0}#publish{background:#d6ff3d;color:#17182c}.publish-box{padding:22px;background:#f0f4e5;border:1px solid #c4cdb3;margin-top:28px}.publish-box p{font-size:13px;line-height:1.6}details{margin-top:23px;padding-top:15px;border-top:1px solid #ddd}summary{cursor:pointer;font-size:13px;font-weight:700;line-height:1.5}.check{display:flex;gap:8px;align-items:start;line-height:1.5}.draft-picker details{margin-top:12px;border:0;padding:0}.activity{border-top:1px solid #ddd;margin-top:25px;padding-top:15px}footer{font-size:12px;padding:30px 0;color:#666}:global(#preview){font-size:14px;line-height:1.75;overflow-wrap:anywhere}:global(#preview h3){font-size:21px;margin:30px 0 10px}:global(#preview h4){font-size:16px;margin:20px 0 5px}:global(#preview p){white-space:pre-wrap}:global(#preview ul){padding-left:22px}:global(#preview details){font-size:12px}:global(#source-review){overflow-wrap:anywhere}:global(#jobs p){font-size:13px;line-height:1.6;border-bottom:1px solid #e2e2db;padding-bottom:10px}:global(#history button){margin:5px 0}:global(:focus-visible){outline:3px solid #2238ff;outline-offset:3px}@media(max-width:800px){.columns{grid-template-columns:1fr}.status-grid{grid-template-columns:1fr}.status-card{padding:12px 16px}.status-card h2{font-size:18px}.toolbar #logout{margin-left:0}}@media(max-width:500px){main{padding:18px}.panel{padding:18px}header span{display:none}.toolbar label{min-width:100%}.actions button{width:100%}}
</style>
