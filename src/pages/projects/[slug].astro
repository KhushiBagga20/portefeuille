---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Arrow from '../../components/Arrow.astro';
import Badge from '../../components/Badge.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import FloppyDisk from '../../components/FloppyDisk.astro';
import { diskTones, projects, type Project } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      index: i,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  index: number;
  prev: Project;
  next: Project;
}

const { project: p, index, prev, next } = Astro.props;
const tone = diskTones[p.disk.tone];
const no = (i: number) => String(i + 1).padStart(2, '0');

// Event and result only make sense for hackathon projects; elsewhere they'd read as "missing".
const isHackathon = p.labels.includes('Hackathon');
const isOngoing = p.labels.includes('Ongoing');
const facts: { label: string; value?: string }[] = [
  { label: 'type', value: p.type },
  ...(p.event || isHackathon ? [{ label: 'event', value: p.event }] : []),
  ...(p.outcome || (isHackathon && !isOngoing) ? [{ label: 'result', value: p.outcome?.join(' · ') }] : []),
  { label: 'my role', value: p.role },
];
const links = [
  { label: 'GitHub', href: p.links.github },
  { label: 'Live demo', href: p.links.demo },
].filter((l): l is { label: string; href: string } => Boolean(l.href));
---

<Base title={`${p.name} · ${site.fullName}`} description={p.oneLiner ?? `${p.name}: ${p.type}.`}>
  <Nav here={`work / ${p.name}`} />
  <main class="case">
    <!-- ── the cover, in the disk's own colour ── -->
    <header class="cover" style={`--tone:${tone.body};--on-tone:${tone.on}`}>
      <div class="cover__inner">
        <p class="cover__strip">
          <a class="cover__back" href="/#projects"><Arrow dir="left" /> all work</a>
          <span>{no(index)} / {no(projects.length - 1)}</span>
          <span class="cover__kind">{[p.type, p.event].filter(Boolean).join(' · ')}</span>
        </p>

        <h1 id="case-title" class="cover__name">{p.name}</h1>
        {p.earlierName && <p class="cover__aka voice">earlier known as {p.earlierName}</p>}
        {p.oneLiner ? <p class="cover__line">{p.oneLiner}</p> : <ComingSoon text="description coming soon" />}
        <div class="cover__tags">
          {p.labels.map((l) => <Badge label={l} />)}
        </div>

        <div class="drive" aria-hidden="true">
          <span class="drive__plate"></span>
          <span class="vt-disk drive__disk" style={`--vt: disk-${p.slug}`}>
            <FloppyDisk tone={p.disk.tone} scribble={p.disk.scribble} />
          </span>
        </div>
      </div>
    </header>

    <div class="case__grid">
      <aside class="side" aria-label="Project facts">
        <dl class="facts">
          {
            facts.map((f) => (
              <div class="fact">
                <dt>{f.label}</dt>
                <dd>{f.value ?? <ComingSoon />}</dd>
              </div>
            ))
          }
          <div class="fact">
            <dt>stack</dt>
            <dd>
              {
                p.stack ? (
                  <ul class="stack">
                    {p.stack.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                ) : (
                  <ComingSoon />
                )
              }
            </dd>
          </div>
          <div class="fact">
            <dt>links</dt>
            <dd>
              {
                links.length ? (
                  <div class="links">
                    {links.map((l) => (
                      <a class="key key--sm" href={l.href}>
                        {l.label} <Arrow dir="out" />
                      </a>
                    ))}
                  </div>
                ) : (
                  <ComingSoon text="links coming soon" />
                )
              }
            </dd>
          </div>
        </dl>
      </aside>

      <article class="body" aria-labelledby="case-title">
        {
          p.sections.map((s, i) => (
            <section class:list={['block', s.kind && `block--${s.kind}`]}>
              <p class="block__no">{no(i)}</p>
              <div class="block__main">
                <h2>{s.title}</h2>
                {s.note && <p class="block__note">{s.note}</p>}
                {s.body && <p class="block__body">{s.body}</p>}
                {s.items && (
                  <ul class="list">
                    {s.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
                {s.groups && (
                  <div class="groups">
                    {s.groups.map((g) => (
                      <div class="group">
                        <h3>{g.title}</h3>
                        <ul class="list">
                          {g.items.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                )}
                {!s.body && !s.items && !s.groups && <ComingSoon />}
              </div>
            </section>
          ))
        }
      </article>
    </div>

    <nav class="pager" aria-label="More projects">
      {
        [
          { p: prev, dir: 'left' as const, word: 'previous' },
          { p: next, dir: 'right' as const, word: 'next' },
        ].map((link) => (
          <a
            class:list={['pager__link', `pager__link--${link.dir}`]}
            href={`/projects/${link.p.slug}/`}
            style={`--tone:${diskTones[link.p.disk.tone].body};--on-tone:${diskTones[link.p.disk.tone].on}`}
          >
            <span class="label">{link.word}</span>
            <span class="pager__name">{link.p.name}</span>
            <Arrow dir={link.dir} />
          </a>
        ))
      }
    </nav>
  </main>
</Base>

<style>
  .case {
    padding-top: var(--bar);
  }

  /* ── cover ──────────────────────────── */
  .cover {
    --bg: var(--tone);
    --fg: var(--on-tone);
    --fg-2: var(--on-tone);
    --line: var(--on-tone);
    --accent: var(--on-tone);
    --on-accent: var(--tone);
    padding: clamp(18px, 2.4vw, 32px) var(--gutter) clamp(36px, 5vw, 80px);
    background: var(--tone);
    color: var(--on-tone);
    overflow: clip;
  }

  .cover__inner {
    position: relative;
    max-width: var(--wrap);
    margin: 0 auto;
  }

  .cover__strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
    margin: 0;
    padding-bottom: 12px;
    border-bottom: 1px solid currentColor;
    font: 500 11px/1.3 var(--font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .cover__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .cover__back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cover__kind {
    margin-left: auto;
  }

  .cover__name {
    max-width: 62%;
    margin: clamp(26px, 4.6vw, 76px) 0 0;
    font-family: var(--font-display);
    font-size: clamp(64px, 16vw, 300px);
    font-stretch: 62%;
    font-weight: 900;
    line-height: 0.76;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .cover__aka {
    margin: 0.5em 0 0;
    font-size: clamp(22px, 2.2vw, 36px);
    line-height: 1;
  }

  .cover__line {
    max-width: 30ch;
    margin: clamp(18px, 2.6vw, 38px) 0 0;
    font-size: clamp(20px, 2.1vw, 33px);
    font-stretch: 88%;
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.012em;
  }

  .cover__inner > :global(.soon) {
    margin-top: 22px;
  }

  .cover__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: clamp(16px, 2vw, 26px);
  }

  /* the disk that flew here from the index, lying on a paper plate */
  .drive {
    position: absolute;
    top: clamp(60px, 7vw, 120px);
    right: clamp(0px, 3vw, 60px);
    display: grid;
    place-items: center;
    width: clamp(200px, 30vw, 470px);
    aspect-ratio: 1;
  }

  .drive__plate {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--c-paper);
  }

  .drive__disk {
    position: relative;
    display: block;
    width: 62%;
    filter: drop-shadow(0 22px 26px rgb(12 13 33 / 0.35));
    rotate: -8deg;
  }

  /* ── body ───────────────────────────── */
  .case__grid {
    display: grid;
    grid-template-columns: minmax(230px, 0.5fr) minmax(0, 1.5fr);
    align-items: start;
    gap: clamp(28px, 5vw, 90px);
    max-width: calc(var(--wrap) + 2 * var(--gutter));
    margin: 0 auto;
    padding: clamp(36px, 5vw, 80px) var(--gutter) clamp(56px, 8vw, 120px);
  }

  .side {
    position: sticky;
    top: calc(var(--bar) + 24px);
  }

  .facts {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--fg);
  }

  .fact {
    padding: 12px 0 13px;
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--fg-2);
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  dd {
    margin: 7px 0 0;
    font-stretch: 92%;
    font-weight: 650;
    line-height: 1.3;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 4px 9px 3px;
    border: 1px solid var(--fg);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .block {
    display: grid;
    grid-template-columns: 4ch minmax(0, 1fr);
    column-gap: clamp(12px, 2vw, 28px);
    padding: clamp(20px, 2.6vw, 36px) 0 clamp(22px, 3vw, 42px);
    border-top: 1px solid var(--fg);
  }

  .block__no {
    margin: 0;
    padding-top: 0.75em;
    color: var(--fg-2);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.09em;
  }

  .block h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 64px);
    font-stretch: 64%;
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .block__main > :global(.soon) {
    margin-top: 16px;
  }

  .block__note {
    margin: 14px 0 0;
    padding-left: 12px;
    border-left: 3px solid var(--accent);
    color: var(--fg-2);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  .block__body {
    max-width: 60ch;
    margin: 14px 0 0;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.5;
  }

  .list {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .list li {
    position: relative;
    padding-left: 22px;
    line-height: 1.42;
  }

  .list li + li {
    margin-top: 8px;
  }

  .list li::before {
    content: '';
    position: absolute;
    top: 0.68em;
    left: 0;
    width: 10px;
    height: 1.5px;
    background: currentColor;
  }

  /* things that already work get a solid mark */
  .block--working .list li::before {
    top: 0.42em;
    width: 9px;
    height: 9px;
    background: var(--accent);
  }

  .block--history .block__main {
    padding: 16px 18px 18px;
    border: 1px dashed var(--fg);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 36px;
    margin-top: 20px;
  }

  .group h3 {
    margin: 0;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ── pager ──────────────────────────── */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--fg);
  }

  .pager__link {
    position: relative;
    display: grid;
    gap: 10px;
    padding: clamp(22px, 3vw, 44px) var(--gutter) clamp(26px, 3.4vw, 50px);
    color: var(--fg);
    text-decoration: none;
    isolation: isolate;
    transition: color 0.25s ease;
  }

  .pager__link + .pager__link {
    border-left: 1px solid var(--fg);
    justify-items: end;
    text-align: right;
  }

  .pager__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--tone);
    scale: 1 0;
    transform-origin: bottom;
    transition: scale 0.42s var(--ease-out);
  }

  .pager__link:hover,
  .pager__link:focus-visible {
    color: var(--on-tone);
  }

  .pager__link:hover::before,
  .pager__link:focus-visible::before {
    scale: 1 1;
  }

  .pager__name {
    font-family: var(--font-display);
    font-size: clamp(34px, 6.4vw, 118px);
    font-stretch: 62%;
    font-weight: 900;
    line-height: 0.82;
    text-transform: uppercase;
  }

  .pager__link :global(.arrow) {
    font-size: clamp(22px, 2.4vw, 38px);
  }

  @media (max-width: 899px) {
    .cover__name {
      max-width: none;
    }

    .drive {
      position: relative;
      top: auto;
      right: auto;
      width: min(64vw, 300px);
      margin-top: 28px;
    }

    .cover__kind {
      margin-left: 0;
    }

    .case__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* phones: the case study first, then the fact sheet */
    .side {
      position: static;
      order: 2;
    }
  }

  @media (max-width: 599px) {
    .groups {
      grid-template-columns: minmax(0, 1fr);
    }

    .pager {
      grid-template-columns: 1fr;
    }

    .pager__link + .pager__link {
      border-top: 1px solid var(--fg);
      border-left: 0;
    }
  }
</style>
