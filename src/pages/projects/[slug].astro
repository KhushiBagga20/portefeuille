---
// A project's case study. One page, built from structured data, for two readers:
//   · someone with a minute  — the cover, "in 60 seconds" and what it does
//   · someone who wants all of it — architecture you can click through, a map of how the
//     idea took shape, the timeline, technical deep dives and a reflection
// The switch in the strip under the nav folds the page down to the short version.
//
// Nothing on this page is written here. The card-level facts come from src/data/projects.ts
// and everything else from src/data/case-studies/<slug>.ts, both through src/lib/content.ts.
// A section only appears when it has content; what is missing is gathered into one honest
// list at the end rather than shown as empty boxes.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Arrow from '../../components/Arrow.astro';
import Badge from '../../components/Badge.astro';
import FloppyDisk from '../../components/FloppyDisk.astro';
import DeepDives from '../../components/case/DeepDives.astro';
import Diagram from '../../components/case/Diagram.astro';
import MindMap from '../../components/case/MindMap.astro';
import Reflection from '../../components/case/Reflection.astro';
import StageMark from '../../components/case/Stage.astro';
import Timeline from '../../components/case/Timeline.astro';
import { diskTones } from '../../data/projects';
import { site } from '../../data/site';
import { caseOutline, getCaseStudy, getProjects } from '../../lib/content';
import type { CaseSectionId, CaseStudy, Project } from '../../lib/types';

export async function getStaticPaths() {
  const projects = await getProjects();
  return Promise.all(
    projects.map(async (project, i) => ({
      params: { slug: project.slug },
      props: {
        project,
        study: await getCaseStudy(project.slug),
        index: i,
        count: projects.length,
        prev: projects[(i - 1 + projects.length) % projects.length],
        next: projects[(i + 1) % projects.length],
      },
    })),
  );
}

interface Props {
  project: Project;
  study: CaseStudy;
  index: number;
  count: number;
  prev: Project;
  next: Project;
}

const { project: p, study, index, count, prev, next } = Astro.props;
const tone = diskTones[p.disk.tone];
// the ticker's dots sit on ink: a dark disk colour would vanish there
const toneOnInk = p.disk.tone === 'mint' ? 'var(--marigold)' : tone.body;
const no = (i: number) => String(i + 1).padStart(2, '0');

const { has, sections, missing, map } = caseOutline(p, study);
const deep = sections.filter((s) => s.depth === 'deep');
const order = (id: CaseSectionId) => no(sections.findIndex((s) => s.id === id));

// ── the numbers the data can give, and no others ──
const featureCount = (study.features ?? []).reduce((n, g) => n + g.items.length, 0);
const numbers: { value: string; unit: string }[] = [
  ...(featureCount ? [{ value: String(featureCount), unit: featureCount === 1 ? 'feature' : 'features' }] : []),
  ...(p.stack ? [{ value: String(p.stack.length), unit: 'technologies' }] : []),
  ...(study.diagrams?.length ? [{ value: String(study.diagrams.reduce((n, d) => n + d.nodes.length, 0)), unit: 'parts mapped' }] : []),
];

const facts: { label: string; value: string }[] = [
  { label: 'type', value: p.type },
  ...(p.event ? [{ label: 'event', value: p.event }] : []),
  ...(p.outcome ? [{ label: 'result', value: p.outcome.join(' · ') }] : []),
  ...(p.role ? [{ label: 'my role', value: p.role }] : []),
  ...(study.updated ? [{ label: 'last updated', value: study.updated }] : []),
];
const links = [
  { label: 'GitHub', href: p.links.github },
  { label: 'Live demo', href: p.links.demo },
].filter((l): l is { label: string; href: string } => Boolean(l.href));

const lede = [...(study.intro.problem ?? []), ...(study.intro.built ?? [])];
---

<Base title={`${p.name} · ${site.fullName}`} description={p.oneLiner ?? `${p.name}: ${p.type}.`}>
  <Nav here={`projects / ${p.name}`} />
  <main class="case" data-case style={`--tone:${tone.body};--on-tone:${tone.on};--tone-on-ink:${toneOnInk};--glow:${tone.glow}`}>
    <!-- ── the cover ─────────────────────────── -->
    <header class="cover" data-pointer>
      <p class="cover__strip">
        <a class="cover__back" href="/#projects"><Arrow dir="left" /> all projects</a>
        <span class="mono">{no(index)} / {no(count - 1)}</span>
        <span class="cover__kind">{[p.type, p.event].filter(Boolean).join(' · ')}</span>
      </p>

      <div class="cover__stage">
        <h1 id="case-title" class="cover__name" style={`--n:${Math.max(5, p.name.length)}`}>{p.name}</h1>

        <div class="drive" aria-hidden="true" data-tilt>
          <span class="drive__plate"></span>
          <span class="vt-disk drive__disk" style={`--vt: disk-${p.slug}`}>
            <FloppyDisk tone={p.disk.tone} scribble={p.disk.scribble} />
          </span>
        </div>
      </div>

      <div class="cover__foot">
        <div class="cover__say">
          {p.earlierName && <p class="cover__aka voice">earlier known as {p.earlierName}</p>}
          {p.oneLiner && <p class="cover__line">{p.oneLiner}</p>}
        </div>
        <div class="cover__tags">
          {p.labels.map((l) => <Badge label={l} />)}
        </div>
      </div>
    </header>

    <!-- ── the stack, running past ───────────── -->
    {
      p.stack && (
        <div class="ticker" aria-hidden="true">
          <div class="ticker__run">
            {[0, 1].map(() => (
              <span>
                {p.stack!.map((s) => (
                  <Fragment>
                    <b>{s}</b>
                    <i />
                  </Fragment>
                ))}
              </span>
            ))}
          </div>
        </div>
      )
    }

    <!-- ── where you are, and how much you want ── -->
    <div class="strip s-paper">
      <nav class="strip__toc" aria-label="On this page">
        {
          sections.map((s) => (
            <a href={`#${s.id}`} data-no-jump data-toc={s.id} data-depth-of={s.depth}>
              <span class="mono">{order(s.id)}</span>
              {s.label}
            </a>
          ))
        }
      </nav>
      {
        deep.length > 0 && (
          <fieldset class="depth">
            <legend class="sr-only">How much to read</legend>
            <label>
              <input type="radio" name="depth" value="brief" />
              <span>60 seconds</span>
            </label>
            <label>
              <input type="radio" name="depth" value="full" checked />
              <span>full study</span>
            </label>
          </fieldset>
        )
      }
    </div>

    <!-- ── A · in 60 seconds ─────────────────── -->
    <section id="brief" class="band band--brief s-paper" data-part aria-labelledby="brief-title">
      <div class="wrap brief">
        <div class="brief__main">
          <p class="band__k mono">({order('brief')})</p>
          <h2 id="brief-title" class="band__title">In 60 seconds</h2>

          {p.oneLiner && <p class="brief__lede">{p.oneLiner}</p>}
          {lede.map((para) => <p class="brief__para">{para}</p>)}
          {p.preview && <p class="brief__para">{p.preview}</p>}
          {!p.oneLiner && lede.length === 0 && <p class="brief__para brief__para--none">This project hasn’t been written up yet. What is confirmed is on the right; the rest is listed at the foot of the page.</p>}

          {
            study.intro.highlights && (
              <ul class="brief__points">
                {study.intro.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )
          }
        </div>

        <aside class="brief__side" aria-label="Fact sheet">
          {
            numbers.length > 0 && (
              <dl class="nums">
                {numbers.map((n) => (
                  <div>
                    <dd>{n.value}</dd>
                    <dt>{n.unit}</dt>
                  </div>
                ))}
              </dl>
            )
          }
          <dl class="facts">
            {
              facts.map((f) => (
                <div class="fact">
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
            {
              p.stack && (
                <div class="fact">
                  <dt>stack</dt>
                  <dd>
                    <ul class="stack">
                      {p.stack.map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )
            }
            {
              links.length > 0 && (
                <div class="fact">
                  <dt>links</dt>
                  <dd class="links">
                    {links.map((l) => (
                      <a class="key key--sm" href={l.href}>
                        {l.label} <Arrow dir="out" />
                      </a>
                    ))}
                  </dd>
                </div>
              )
            }
          </dl>
        </aside>

        {
          study.intro.media && (
            <div class="shots">
              {study.intro.media.map((m) => (
                <figure class="shot">
                  {m.kind === 'image' ? (
                    <img src={m.src} alt={m.alt} width={m.width} height={m.height} loading="lazy" decoding="async" />
                  ) : (
                    <video src={m.src} controls preload="metadata" aria-label={m.alt} />
                  )}
                  {m.caption && <figcaption>{m.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- ── what it does ──────────────────────── -->
    {
      has.features && (
        <section id="features" class="band s-paper-2" data-part aria-labelledby="features-title">
          <div class="wrap">
            <header class="band__head">
              <p class="band__k mono">({order('features')})</p>
              <h2 id="features-title" class="band__title">What it does</h2>
              <p class="band__note mono">
                {featureCount} {featureCount === 1 ? 'feature' : 'features'} in {study.features!.length} {study.features!.length === 1 ? 'group' : 'groups'}
              </p>
            </header>

            <div class:list={['tiles', { 'tiles--one': study.features!.length === 1 }]} data-reveal>
              {study.features!.map((g) => (
                <div class="tile">
                  <header class="tile__head">
                    <h3>{g.title}</h3>
                    {g.stage && <StageMark stage={g.stage} word={g.stage === 'done' ? 'working' : g.stage === 'ongoing' ? 'being built' : undefined} />}
                  </header>
                  {g.note && <p class="tile__note">{g.note}</p>}
                  <ul class="list">
                    {g.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- the fold: everything after this is the full study -->
    {
      deep.length > 0 && (
        <div class="fold s-paper-2">
          <p class="fold__brief">
            <span class="mono">that was the short version</span>
            <button class="key key--solid" type="button" data-depth-to="full">
              read the full study <Arrow dir="down" />
            </button>
          </p>
          <p class="fold__full mono" aria-hidden="true">
            the full study <i /> {deep.map((s) => s.label.toLowerCase()).join(' · ')}
          </p>
        </div>
      )
    }

    <!-- ── B · architecture ──────────────────── -->
    {
      has.architecture && (
        <section id="architecture" class="band s-ink" data-part data-deep aria-labelledby="architecture-title">
          <div class="wrap">
            <header class="band__head">
              <p class="band__k mono">({order('architecture')})</p>
              <h2 id="architecture-title" class="band__title">Architecture</h2>
              <p class="band__note mono">every part is a button</p>
            </header>
            {study.diagrams!.map((d) => (
              <Diagram diagram={d} />
            ))}
          </div>
        </section>
      )
    }

    <!-- ── C · how it took shape ─────────────── -->
    {
      has.thinking && (
        <section id="thinking" class="band s-paper" data-part data-deep aria-labelledby="thinking-title">
          <div class="wrap">
            <header class="band__head">
              <p class="band__k mono">({order('thinking')})</p>
              <h2 id="thinking-title" class="band__title">How it took shape</h2>
              <p class="band__note mono">a map: open a branch</p>
            </header>
            <MindMap root={p.name} branches={map} />
          </div>
        </section>
      )
    }

    <!-- ── D · timeline ──────────────────────── -->
    {
      has.timeline && (
        <section id="timeline" class="band s-paper-2" data-part data-deep aria-labelledby="timeline-title">
          <div class="wrap">
            <header class="band__head">
              <p class="band__k mono">({order('timeline')})</p>
              <h2 id="timeline-title" class="band__title">Timeline</h2>
              <p class="band__note mono">oldest first</p>
            </header>
            <Timeline milestones={study.timeline} updates={study.updates} />
          </div>
        </section>
      )
    }

    <!-- ── E · deep dives ────────────────────── -->
    {
      has['deep-dives'] && (
        <section id="deep-dives" class="band s-ink" data-part data-deep aria-labelledby="deep-dives-title">
          <div class="wrap">
            <header class="band__head">
              <p class="band__k mono">({order('deep-dives')})</p>
              <h2 id="deep-dives-title" class="band__title">Deep dives</h2>
              <p class="band__note mono">for the curious</p>
            </header>
            <DeepDives dives={study.deepDives!} />
          </div>
        </section>
      )
    }

    <!-- ── F · reflection ────────────────────── -->
    {
      has.reflection && (
        <section id="reflection" class="band band--tone" data-part data-deep aria-labelledby="reflection-title">
          <div class="wrap">
            <header class="band__head">
              <p class="band__k mono">({order('reflection')})</p>
              <h2 id="reflection-title" class="band__title">Reflection</h2>
              <p class="band__note mono">looking back</p>
            </header>
            <Reflection reflection={study.reflection!} />
          </div>
        </section>
      )
    }

    <!-- ── what isn't here yet ───────────────── -->
    {
      missing.length > 0 && (
        <section class="band band--todo s-paper" aria-labelledby="todo-title">
          <div class="wrap todo">
            <header class="band__head">
              <p class="band__k mono">(—)</p>
              <h2 id="todo-title" class="band__title">{sections.length > 2 ? 'Still to come' : 'Not written up yet'}</h2>
              <p class="band__note mono">{missing.length} to write</p>
            </header>
            <p class="todo__say">
              {sections.length > 2
                ? 'This case study is still being written. These parts aren’t here yet, and nothing on this page stands in for them.'
                : 'Only the confirmed facts are on this page so far. The write-up will add:'}
            </p>
            <ul class="todo__list">
              {missing.map((m) => (
                <li>{m}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <nav class="pager s-paper" aria-label="More projects">
      {
        [
          { p: prev, dir: 'left' as const, word: 'previous' },
          { p: next, dir: 'right' as const, word: 'next' },
        ].map((link) => (
          <a
            class:list={['pager__link', `pager__link--${link.dir}`]}
            href={`/projects/${link.p.slug}/`}
            style={`--tone:${diskTones[link.p.disk.tone].body};--on-tone:${diskTones[link.p.disk.tone].on}`}
          >
            <span class="label">{link.word}</span>
            <span class="pager__name">{link.p.name}</span>
            <Arrow dir={link.dir} />
          </a>
        ))
      }
    </nav>
  </main>
</Base>

<script>
  const page = document.querySelector<HTMLElement>('[data-case]');

  // ── how much to read ──
  // The radios work without this (the stylesheet reads them with :has); the script only
  // remembers the choice for the visit and wires up the "read the full study" button.
  const KEY = 'khushi:case-depth';
  const radios = [...document.querySelectorAll<HTMLInputElement>('input[name="depth"]')];
  const setDepth = (depth: string, remember = true) => {
    radios.forEach((r) => (r.checked = r.value === depth));
    if (!remember) return;
    try {
      sessionStorage.setItem(KEY, depth);
    } catch {}
  };
  try {
    const saved = sessionStorage.getItem(KEY);
    if (saved && radios.length) setDepth(saved, false);
  } catch {}
  radios.forEach((r) => r.addEventListener('change', () => setDepth(r.value)));
  document.querySelectorAll<HTMLButtonElement>('[data-depth-to]').forEach((b) =>
    b.addEventListener('click', () => {
      setDepth(b.dataset.depthTo!);
      const first = page?.querySelector<HTMLElement>('[data-deep]');
      requestAnimationFrame(() => first?.scrollIntoView({ block: 'start' }));
    }),
  );
  // a link into the full study opens it first
  document.querySelectorAll<HTMLAnchorElement>('[data-toc][data-depth-of="deep"]').forEach((a) => a.addEventListener('click', () => setDepth('full')));
  if (location.hash && document.querySelector(`${location.hash}[data-deep]`)) setDepth('full');

  // ── where you are ──
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  if (links.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => {
            const on = a.dataset.toc === e.target.id;
            if (on) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
            if (on) a.scrollIntoView({ block: 'nearest', inline: 'nearest' });
          });
        }
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    document.querySelectorAll('[data-part]').forEach((part) => io.observe(part));
  }
</script>

<style>
  .case {
    --strip: 46px;
    padding-top: var(--bar);
  }

  /* ── 1 · cover ──────────────────────── */
  .cover {
    --bg: var(--tone);
    --fg: var(--on-tone);
    --fg-2: var(--on-tone);
    --line: var(--on-tone);
    --accent: var(--on-tone);
    --on-accent: var(--tone);
    --px: 0;
    --py: 0;
    display: flex;
    flex-direction: column;
    min-height: min(calc(100svh - var(--bar)), 900px);
    padding: clamp(16px, 2vw, 28px) var(--gutter) clamp(22px, 3vw, 40px);
    background: var(--tone);
    color: var(--on-tone);
    overflow: clip;
  }

  .cover__strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
    margin: 0;
    padding-bottom: 12px;
    border-bottom: 1px solid currentColor;
    font: 700 11px/1.3 var(--font-label);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .cover__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .cover__back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cover__kind {
    margin-left: auto;
  }

  /* the name as wide as the page; the disk lies across the end of it */
  .cover__stage {
    position: relative;
    display: grid;
    flex: 1;
    align-items: center;
    container-type: inline-size;
    margin: clamp(10px, 2vw, 30px) 0;
  }

  .cover__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: min(31cqw, 62svh, calc(100cqw / (var(--n) * 0.54)));
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .drive {
    --tx: 0;
    --ty: 0;
    position: absolute;
    right: clamp(0px, 2cqw, 40px);
    bottom: clamp(-30px, -2cqw, 0px);
    display: grid;
    place-items: center;
    width: clamp(170px, 27cqw, 420px);
    aspect-ratio: 1;
    perspective: 900px;
    translate: calc(var(--px) * -14px) calc(var(--py) * -10px);
    transition: translate 0.5s var(--ease-out);
  }

  .drive__plate {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--c-paper);
  }

  .drive__disk {
    position: relative;
    display: block;
    width: 62%;
    filter: drop-shadow(0 22px 26px rgb(12 13 33 / 0.35));
    transform: rotate(-8deg) rotateY(calc(var(--tx) * 18deg)) rotateX(calc(var(--ty) * -14deg));
    transition: transform 0.5s var(--ease-out);
  }

  .cover__foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 16px 32px;
    padding-top: clamp(14px, 1.8vw, 24px);
    border-top: 1px solid currentColor;
  }

  .cover__aka {
    margin: 0 0 0.5em;
    font-size: clamp(18px, 1.7vw, 26px);
    line-height: 1.1;
  }

  .cover__line {
    max-width: 34ch;
    margin: 0;
    font-size: clamp(20px, 2.2vw, 34px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.014em;
  }

  .cover__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    max-width: 340px;
  }

  /* ── 2 · ticker ─────────────────────── */
  .ticker {
    padding: clamp(10px, 1.4vw, 20px) 0 clamp(8px, 1.2vw, 16px);
    background: var(--c-ink);
    color: var(--c-paper);
    overflow: clip;
    white-space: nowrap;
  }

  .ticker__run {
    display: inline-flex;
    animation: ticker 38s linear infinite;
  }

  .ticker__run > span {
    display: inline-flex;
    align-items: center;
  }

  .ticker b {
    font-family: var(--font-display);
    font-size: clamp(34px, 5.6vw, 92px);
    font-weight: 400;
    line-height: 0.94;
    text-transform: uppercase;
  }

  .ticker i {
    flex: none;
    width: clamp(10px, 1.3vw, 20px);
    aspect-ratio: 1;
    margin: 0 clamp(14px, 2vw, 34px);
    border-radius: 50%;
    background: var(--tone-on-ink);
  }

  @keyframes ticker {
    to {
      translate: -50% 0;
    }
  }


  /* ── the strip: sections, and the depth switch ── */
  .strip {
    position: sticky;
    top: var(--bar);
    z-index: 20;
    display: flex;
    align-items: stretch;
    height: var(--strip);
    border-bottom: 1px solid var(--fg);
    background: var(--bg);
    color: var(--fg);
  }

  .strip__toc {
    display: flex;
    flex: 1;
    min-width: 0;
    padding: 0 calc(var(--gutter) - 12px);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .strip__toc::-webkit-scrollbar {
    display: none;
  }

  .strip__toc a {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 7px;
    padding: 0 12px;
    font: 650 13.5px/1 var(--font-body);
    text-decoration: none;
    white-space: nowrap;
  }

  .strip__toc a .mono {
    color: var(--fg-2);
    font-size: 11px;
  }

  .strip__toc a::after {
    content: '';
