---
// The link-preview card (1200 × 630). Not a real page: `npm run og` screenshots it into public/og.png.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import Collage from '../components/Collage.astro';
import Rosette from '../components/Rosette.astro';
import { site } from '../data/site';

const [first, ...rest] = site.headline.split(', ');
const letters = [...site.name.toUpperCase()];
---

<!doctype html>
<html lang="en" data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>link preview</title>
  </head>
  <body>
    <div class="og">
      <p class="mast">{letters.map((ch) => <span>{ch}</span>)}</p>

      <div class="bloom">
        <Rosette
          rings={[
            { n: 16, at: 74, r: 15.5, fill: 'var(--marigold)' },
            { n: 11, at: 47, r: 15, fill: 'var(--marigold-pale)' },
            { n: 7, at: 23, r: 12.5, fill: 'var(--marigold-deep)' },
          ]}
          core={{ r: 8.5, fill: 'var(--signal)' }}
        />
      </div>

      <div class="art"><Collage /></div>

      <p class="mast mast--ghost" aria-hidden="true">{letters.map((ch) => <span>{ch}</span>)}</p>

      <div class="copy">
        <p class="headline">
          <span class="headline__a">{first},</span>
          <span class="headline__b">{rest.join(', ')}</span>
        </p>
        <p class="meta">{site.fullName} — {site.tag} · {site.program}</p>
      </div>
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
    overflow: hidden;
  }

  .og {
    position: relative;
    width: 1200px;
    height: 630px;
    padding: 30px 44px;
    background: var(--c-paper);
    color: var(--c-ink);
    overflow: hidden;
  }

  .mast {
    position: relative;
    z-index: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: 250px;
    font-weight: 900;
    line-height: 0.76;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .mast--ghost {
    position: absolute;
    top: 30px;
    right: 44px;
    left: 44px;
    z-index: 4;
    color: transparent;
    -webkit-text-stroke: 2px var(--c-paper);
    /* only across the portrait */
    clip-path: inset(0 72px 0 682px);
  }

  .bloom {
    position: absolute;
    top: 210px;
    left: 600px;
    z-index: 2;
    width: 400px;
    mix-blend-mode: multiply;
  }

  .art {
    position: absolute;
    top: 48px;
    right: 130px;
    z-index: 3;
    width: 330px;
  }

  /* the card is a still: show the collage without waiting for its entrance */
  .art :global(.collage) {
    opacity: 1 !important;
    scale: 1 !important;
    rotate: 2.5deg !important;
  }

  .copy {
    position: absolute;
    bottom: 34px;
    left: 44px;
    z-index: 5;
  }

  .headline {
    margin: 0;
    font-size: 78px;
    line-height: 0.9;
  }

  .headline__a {
    display: block;
    font-family: var(--font-display);
    font-stretch: 66%;
    font-weight: 800;
    text-transform: uppercase;
  }

  .headline__b {
    display: block;
    margin-top: 0.08em;
    font-family: var(--font-display);
    font-size: 0.84em;
    font-weight: 300;
    letter-spacing: -0.03em;
  }

  .meta {
    margin: 18px 0 0;
    font: 500 14px/1 var(--font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
</style>
