---
// Room 03. The Writing Room's contents page.
//
// Set like the front of a small literary magazine rather than a blog: a masthead, then
// the pieces as a column of large titles. A title is the door to its piece — reach for
// one and its opening lines unfold underneath, set the way they will be on the page.
//
// The pieces are Markdown files in src/content/writing/ (one file each).
import Play from '../../../layouts/Play.astro';
import Arrow from '../../../components/Arrow.astro';
import PosterHead from '../../../components/PosterHead.astro';
import { room } from '../../../data/playground';
import { getWriting, plural } from '../../../lib/content';
import type { WritingKind } from '../../../lib/types';

const r = room('writing');
const pieces = await getWriting();
const samples = pieces.some((p) => p.sample);

const kinds: { id: WritingKind; one: string; many: string }[] = [
  { id: 'poem', one: 'poem', many: 'poems' },
  { id: 'essay', one: 'essay', many: 'essays' },
  { id: 'fiction', one: 'story', many: 'fiction' },
];
const shelves = kinds.map((k) => ({ ...k, count: pieces.filter((p) => p.kind === k.id).length })).filter((k) => k.count > 0);
// the room has two halves; a piece says which it belongs to with `side`
const parts = [
  { id: 'professional', name: 'Professional', note: 'essays', empty: 'Nothing here yet.' },
  { id: 'personal', name: 'Personal', note: 'poems and the rest', empty: 'Nothing here yet. The poems are on their way.' },
].map((part) => ({ ...part, pieces: pieces.filter((p) => p.side === part.id) }));
const word = (kind: WritingKind) => kinds.find((k) => k.id === kind)!.one;
const two = (n: number) => String(n).padStart(2, '0');
const year = (date?: string) => date?.slice(0, 4);
const totalWords = pieces.reduce((n, p) => n + p.words, 0);
---

<Play here="writing" title="Writing" description="Professional and personal writing, set to be read slowly.">
  <section class="room" data-writing aria-labelledby="writing-title">
    <div class="room__in">
      <PosterHead index={r.no} name={r.name} note={`${plural(pieces.length, 'piece')} · ${totalWords.toLocaleString('en')} words`} />

      <header class="mast">
        <h1 id="writing-title" class="mast__title">
          <span class="mast__a">Writing</span>
          <span class="mast__b voice">room.</span>
        </h1>
        <div class="mast__side">
          <p class="mast__lede">Two shelves, professional and personal. Nothing here is in a hurry: pick a title and read it slowly.</p>
          {
            samples && (
              <p class="mast__sample mono">
                sample pieces for now. They explain how to add real ones, and step aside when the first is added.
              </p>
            )
          }
        </div>
      </header>

      {
        shelves.length > 1 && (
          <div class="shelves" role="group" aria-label="Show one kind of writing">
            <button type="button" data-kind="all" aria-pressed="true">
              everything <i>{two(pieces.length)}</i>
            </button>
            {shelves.map((s) => (
              <button type="button" data-kind={s.id} aria-pressed="false">
                {s.many} <i>{two(s.count)}</i>
              </button>
            ))}
          </div>
        )
      }

      {
        parts.map((part) => (
          <section class="part" data-part aria-labelledby={`part-${part.id}`}>
            <header class="part__head">
              <h2 id={`part-${part.id}`} class="part__name">
                {part.name}
              </h2>
              <p class="part__note mono">
                {part.note} · {part.pieces.length ? plural(part.pieces.length, 'piece') : 'nothing yet'}
              </p>
            </header>
            {part.pieces.length === 0 && <p class="part__empty">{part.empty}</p>}
            <ol class="contents">
              {part.pieces.map((p, i) => (
                <li class="entry" data-entry={p.kind}>
                  <a class="entry__link" href={`/playground/writing/${p.slug}/`}>
                    <span class="entry__no mono">{two(i + 1)}</span>
                    <span class="entry__main">
                      <span class="entry__title" style={`view-transition-name: writing-${p.slug}`}>
                        {p.title}
                      </span>
                      <!-- the opening lines, folded away until the title is reached for -->
                      <span class="entry__fold">
                        <span class:list={['entry__open', `entry__open--${p.kind}`]}>{p.excerpt}</span>
                      </span>
                    </span>
                    <span class="entry__meta mono">
                      <span class="entry__kind">{word(p.kind)}</span>
                      {year(p.date) && <span>{year(p.date)}</span>}
                      <span>{p.minutes} min</span>
                      {p.sample && <span class="entry__sample">sample</span>}
                    </span>
                    <span class="entry__go" aria-hidden="true">
                      <Arrow />
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }

      <p class="none" data-none hidden>Nothing of that kind yet.</p>
    </div>
  </section>
</Play>

<script>
  const room = document.querySelector<HTMLElement>('[data-writing]');
  const buttons = [...(room?.querySelectorAll<HTMLButtonElement>('[data-kind]') ?? [])];
  const entries = [...(room?.querySelectorAll<HTMLElement>('[data-entry]') ?? [])];
  const none = room?.querySelector<HTMLElement>('[data-none]');

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const kind = b.dataset.kind!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let shown = 0;
      for (const e of entries) {
        const on = kind === 'all' || e.dataset.entry === kind;
        e.hidden = !on;
        if (on) shown++;
      }
      if (none) none.hidden = shown > 0;
    }),
  );
</script>

<style>
  /* ── a lit, quiet room: paper and ink ── */
  .room {
    --bg: var(--c-paper);
    --fg: #0c0d21;
    --fg-2: #4b4d68;
    --line: rgb(12 13 33 / 0.2);
    --accent: var(--signal);
    --on-accent: #0c0d21;
    min-height: calc(100svh - var(--bar));
    padding: clamp(18px, 2.4vw, 34px) var(--gutter) clamp(56px, 8vw, 120px);
    background: var(--bg);
    color: var(--fg);
  }

  .room__in {
    max-width: var(--wrap);
    margin: 0 auto;
  }

  /* ── masthead ───────────────────────── */
  .mast {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.42fr);
    align-items: end;
    gap: 20px clamp(24px, 5vw, 80px);
    margin-top: clamp(14px, 2vw, 28px);
    padding-bottom: clamp(18px, 2.6vw, 38px);
    border-bottom: 1.5px solid var(--fg);
  }

  .mast__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.14em;
    margin: 0;
    font-size: clamp(72px, 16.5vw, 290px);
    line-height: 0.86;
  }

  .mast__a {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.004em;
    text-transform: uppercase;
  }

  .mast__b {
    font-size: 0.5em;
    letter-spacing: -0.05em;
  }

  .mast__lede {
    max-width: 30ch;
    margin: 0;
    font-size: var(--fs-lede);
    font-weight: 450;
    line-height: 1.34;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }

  .mast__sample {
    max-width: 44ch;
    margin: 14px 0 0;
    padding: 9px 12px 8px;
    border: 1px dashed var(--fg);
    line-height: 1.5;
  }

  /* ── shelves ────────────────────────── */
  .shelves {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: clamp(16px, 2vw, 26px);
  }

  .shelves button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 15px;
    border: 1.5px solid var(--fg);
    border-radius: 999px;
    background: none;
    color: var(--fg);
    font: 650 14px/1 var(--font-body);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }

  .shelves i {
    color: var(--fg-2);
    font: 500 11px/1 var(--font-mono);
  }

  .shelves button:hover {
    background: color-mix(in srgb, var(--fg) 9%, transparent);
  }

  .shelves button[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
  }

  .shelves button[aria-pressed='true'] i {
    color: inherit;
  }

  /* ── the two halves ─────────────────── */
  .part {
    margin-top: clamp(40px, 6vw, 88px);
  }

  .part__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 24px;
    padding-bottom: clamp(10px, 1.2vw, 16px);
    border-bottom: 2px solid var(--fg);
  }

  .part__name {
    margin: 0;
    font: 400 var(--fs-head) / 1 var(--font-head);
    letter-spacing: -0.04em;
  }

  .part__note {
    margin: 0;
    color: var(--fg-2);
    font-size: var(--fs-meta);
  }

  .part__empty {
    margin: clamp(18px, 2.4vw, 30px) 0 0;
    color: var(--fg-2);
    font-size: var(--fs-lede);
  }

  /* ── the contents ───────────────────── */
  .contents {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    border-bottom: 1px solid var(--line);
  }

  .entry[hidden] {
    display: none;
  }

  .entry__link {
    position: relative;
    display: grid;
    grid-template-columns: 4ch minmax(0, 1fr) auto 34px;
    align-items: baseline;
    gap: 0 clamp(12px, 2vw, 30px);
    padding: clamp(18px, 2.4vw, 34px) 0 clamp(16px, 2.2vw, 30px);
    text-decoration: none;
  }

  .entry__no {
    color: var(--fg-2);
  }

  .entry__title {
    display: inline-block;
    font: 400 clamp(32px, 5.4vw, 92px) / 0.98 var(--font-head);
    letter-spacing: -0.05em;
    text-wrap: balance;
    transition: translate 0.5s var(--ease-out);
  }

  .entry__meta {
    display: grid;
    gap: 5px;
    color: var(--fg-2);
    text-align: right;
    white-space: nowrap;
  }

  .entry__kind {
    color: var(--fg);
    font-weight: 600;
  }

  .entry__sample {
    justify-self: end;
    padding: 3px 7px 2px;
    border: 1px dashed currentColor;
  }

  .entry__go {
    align-self: center;
    font-size: clamp(22px, 2.2vw, 34px);
    opacity: 0;
    translate: -12px 0;
    transition:
      opacity 0.3s ease,
      translate 0.5s var(--ease-out);
  }

  /* the fold: zero rows tall until the title is reached for */
  .entry__fold {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.55s var(--ease-out);
  }

  .entry__open {
    min-height: 0;
    max-width: 58ch;
    overflow: hidden;
    color: var(--fg-2);
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.55;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .entry__open::before {
    content: '';
    display: block;
    height: clamp(12px, 1.4vw, 20px);
  }

  /* a poem keeps its lines, even in a preview */
  .entry__open--poem {
    white-space: pre-line;
    line-height: 1.7;
  }

  .entry__link:hover .entry__fold,
  .entry__link:focus-visible .entry__fold {
    grid-template-rows: 1fr;
  }

  .entry__link:hover .entry__open,
  .entry__link:focus-visible .entry__open {
    opacity: 1;
    transition-delay: 0.12s;
  }

  .entry__link:hover .entry__title,
  .entry__link:focus-visible .entry__title {
    translate: clamp(8px, 1.2vw, 20px) 0;
  }

  .entry__link:hover .entry__go,
  .entry__link:focus-visible .entry__go {
    opacity: 1;
    translate: 0 0;
  }

  /* an editor's mark in the margin */
  .entry__link::before {
    content: '';
    position: absolute;
    top: clamp(18px, 2.4vw, 34px);
    bottom: clamp(16px, 2.2vw, 30px);
    left: calc(4ch + clamp(12px, 2vw, 30px) - clamp(6px, 0.9vw, 14px));
    width: 4px;
    background: var(--accent);
    scale: 1 0;
    transform-origin: top;
    transition: scale 0.45s var(--ease-out);
  }

  .entry__link:hover::before,
  .entry__link:focus-visible::before {
    scale: 1 1;
  }

  .entry__link:focus-visible {
    outline-offset: 4px;
  }

  /* no hover to reach with: the openings are simply there */
  @media (hover: none) {
    .entry__fold {
      grid-template-rows: 1fr;
    }

    .entry__open {
      opacity: 1;
    }

    .entry__go {
      opacity: 1;
      translate: 0 0;
    }
  }

  .none {
    margin: 28px 0 0;
    color: var(--fg-2);
    font-size: var(--fs-lede);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .mast__a,
    :global(.js) .mast__b {
      animation: w-rise 0.9s var(--ease-out) backwards;
    }

    :global(.js) .mast__b {
      animation-delay: 0.12s;
    }

    :global(.js) .entry {
      animation: w-in 0.7s var(--ease-out) backwards;
      animation-delay: calc(0.25s + var(--i, 0) * 70ms);
    }

    :global(.js) .entry:nth-child(2) {
      --i: 1;
    }
    :global(.js) .entry:nth-child(3) {
      --i: 2;
    }
    :global(.js) .entry:nth-child(n + 4) {
      --i: 3;
    }

    @keyframes w-rise {
      from {
        opacity: 0;
        translate: 0 0.3em;
      }
    }

    @keyframes w-in {
      from {
        opacity: 0;
        translate: 0 18px;
      }
    }
  }

  @media (max-width: 799px) {
    .mast {
      grid-template-columns: minmax(0, 1fr);
    }

    .entry__link {
      grid-template-columns: 3.4ch minmax(0, 1fr) 26px;
    }

    .entry__meta {
      grid-column: 2;
      grid-row: 2;
      display: flex;
      flex-wrap: wrap;
      gap: 4px 14px;
      margin-top: 10px;
      text-align: left;
    }

    .entry__go {
      grid-column: 3;
      grid-row: 1;
    }

    .entry__link::before {
      left: calc(3.4ch + clamp(12px, 2vw, 30px) - 8px);
    }
  }
</style>
