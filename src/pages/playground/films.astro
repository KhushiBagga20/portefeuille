---
// Room 05. The film & television archive, as a screening room.
//
// One title is on the screen at a time: its poster, its name the size of a title card, and
// what I think of it. Underneath runs a strip of film — every frame is a title; click one,
// or walk the strip with the arrow keys, and the screen cuts to it. The shelves above the
// strip re-cut the reel by mood, by genre, or by what a title means to me.
//
// What is in the archive is listed in src/data/films.ts.
import Play from '../../layouts/Play.astro';
import PosterHead from '../../components/PosterHead.astro';
import { room } from '../../data/playground';
import { getScreenings, getShelves, plural } from '../../lib/content';

const r = room('films');
const shows = await getScreenings();
const shelves = await getShelves();
const two = (n: number) => String(n).padStart(2, '0');
const samples = shows.some((s) => s.sample);

const films = shows.filter((s) => s.type === 'film').length;
const series = shows.length - films;
const cuts = [
  { id: 'all', name: 'the whole reel', by: '', count: shows.length },
  ...shelves.map((s) => ({ id: `shelf:${s.id}`, name: s.name, by: s.by, count: s.count })),
  ...(films && series ? [
    { id: 'type:film', name: 'films', by: 'type', count: films },
    { id: 'type:series', name: 'series', by: 'type', count: series },
  ] : []),
];
const byWord = { mood: 'mood', genre: 'genre', significance: 'why it matters', collection: 'my set', type: 'kind' } as Record<string, string>;
const sources = [...new Set(shows.map((s) => s.artSource).filter(Boolean))];
const sets = new Map(shows.filter((s) => s.set).map((s) => [s.set!.id, shows.filter((x) => x.set?.id === s.set!.id)]));

// A poster drawn from type. Every title has one: it is what shows if there is no artwork,
// and what is left if an image fails to load. Each gets one of a few grounds.
const grounds = [
  { bg: 'var(--signal)', fg: '#0c0d21' },
  { bg: 'var(--cobalt)', fg: '#ffffff' },
  { bg: '#f3f3ef', fg: '#0c0d21' },
  { bg: 'var(--marigold)', fg: '#0c0d21' },
  { bg: 'var(--magenta)', fg: '#0c0d21' },
  { bg: '#1c1e3d', fg: '#f3f3ef' },
];
// a title card is shown whole on black, the ground those cards are made for
const ground = (i: number, titlecard = false) =>
  titlecard ? '--pbg:#000000;--pfg:#f3f3ef' : `--pbg:${grounds[i % grounds.length].bg};--pfg:${grounds[i % grounds.length].fg}`;
---

<Play here="films" title="Films & television" description="A filmstrip of the films and shows I keep: click a frame and the screen cuts to it.">
  <section class="cinema" data-cinema aria-labelledby="cinema-title">
    <div class="cinema__top">
      <PosterHead index={r.no} name={r.name} note={`${plural(shows.length, 'title')} · ${plural(shelves.length, 'shelf', 'shelves')}`} />
      <h1 id="cinema-title" class="sr-only">Films and television</h1>
    </div>

    <!-- ── the screen ─────────────────────── -->
    <div class="screen" data-screen>
      {
        shows.map((s, i) => (
          <article class="show" id={`film-${s.id}`} data-show={s.id} role="tabpanel" aria-labelledby={`frame-${s.id}`} hidden={i > 0}>
            <button class="show__poster" type="button" data-open={s.id} aria-haspopup="dialog" aria-label={`${s.title}: look closer`} style={ground(i, s.poster?.kind === 'titlecard')}>
              <span class:list={['card', s.poster && `card--${s.poster.kind}`]} data-card>
                <span class="card__k">
                  <span>{s.sample ? 'sample' : s.type}</span>
                  {s.set && <span>{s.set.at} / {s.set.of}</span>}
                </span>
                {s.poster?.kind === 'titlecard' && (
                  <span class="card__logo">
                    <img src={s.poster.src} alt={s.poster.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" onerror="this.parentElement.remove()" />
                  </span>
                )}
                <span class="card__title">{s.title}</span>
                <span class="card__foot">
                  <span>{s.year ?? (s.poster ? '' : 'no poster yet')}</span>
                  <span>{s.no}</span>
                </span>
                {s.poster?.kind === 'poster' && (
                  <img class="card__poster" src={s.poster.src} alt={s.poster.alt} width={s.poster.width} height={s.poster.height} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />
                )}
              </span>
            </button>

            <div class="show__text">
              <p class="show__k mono">
                <span class="show__frame">
                  frame {s.no} / {two(shows.length)}
                </span>
                <span>{s.type}</span>
                {s.year && <span>{s.year}</span>}
                {s.by && <span>by {s.by}</span>}
              </p>
              <h2 class="show__title" data-show-title>{s.title}</h2>
              {s.line && <p class="show__line voice">{s.line}</p>}
              {
                s.note && (
                  <div class="show__thoughts" data-show-note>
                    <p class="show__label mono">why it matters to me</p>
                    <p>{s.note}</p>
                  </div>
                )
              }
              {
                s.set && (
                  <div class="trio">
                    <p class="show__label mono">
                      {s.set.name} · {s.set.at} of {s.set.of}
                    </p>
                    <div class="trio__row">
                      {sets.get(s.set.id)!.map((m) => (
                        <button type="button" data-goto={m.id} aria-current={m.id === s.id ? 'true' : undefined}>
                          <i>{m.set!.at}</i>
                          {m.title}
                        </button>
                      ))}
                    </div>
                  </div>
                )
              }
              {
                s.thoughts && (
                  <div class="show__thoughts">
                    <p class="show__label mono">what I think</p>
                    {s.thoughts.map((para) => (
                      <p>{para}</p>
                    ))}
                  </div>
                )
              }
              {s.sample && (
                <p class="show__shelves">
                  <span class="show__sample">sample entry — not a real title</span>
                </p>
              )}
            </div>
          </article>
        ))
      }
      <!-- the cut: two black bars that close and open between titles -->
      <span class="screen__bars" aria-hidden="true"></span>
    </div>

    <!-- ── the reel ───────────────────────── -->
    <div class="reel">
      <div class="reel__bar">
        <div class="cuts" role="group" aria-label="Re-cut the reel">
          {
            cuts.map((c, i) => (
              <button type="button" data-cut={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                {c.by && <span class="cuts__by">{byWord[c.by]}</span>}
                {c.name}
                <i>{two(c.count)}</i>
              </button>
            ))
          }
        </div>
        <div class="reel__step">
          <button type="button" data-step="-1" aria-label="Previous title">←</button>
          <span class="mono" data-counter aria-live="polite">01 / {two(shows.length)}</span>
          <button type="button" data-step="1" aria-label="Next title">→</button>
        </div>
      </div>

      <div class="strip" data-strip role="tablist" aria-label="Titles, as frames on a strip of film" aria-orientation="horizontal">
        {
          shows.map((s, i) => (
            <button
              class="frame"
              id={`frame-${s.id}`}
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`film-${s.id}`}
              tabindex={i === 0 ? 0 : -1}
              data-frame={s.id}
              data-shelves={s.shelves.join(' ')}
              data-type={s.type}
              data-format={s.type}
              data-year={s.year}
              data-set={s.set?.id}
              data-set-name={s.set?.at === 1 ? s.set.name : undefined}
              data-set-line={s.set ? `${s.set.name} · ${s.set.at} of ${s.set.of}` : undefined}
              style={ground(i, s.poster?.kind === 'titlecard')}
            >
              <span class="frame__cell">
                <span class="frame__name">{s.title}</span>
                {s.poster && <img src={s.poster.src} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />}
                <span class="frame__no">{s.no}</span>
              </span>
              <span class="sr-only">
                {s.title}
                {s.year ? `, ${s.year}` : ''}
              </span>
            </button>
          ))
        }
      </div>
      {samples && <p class="reel__sample mono">a sample reel for now — it names no real film or show, and steps aside when the first real title is added</p>}
      {sources.length > 0 && <p class="reel__sample mono">artwork: official posters and title cards, via {sources.join(', ')} · click a poster to look closer</p>}
    </div>
  </section>

  <!-- the detail view: one title, its artwork as large as it goes -->
  <dialog class="lb" data-lightbox aria-labelledby="lb-title">
    <div class="lb__in">
      <div class="lb__art" data-lb-art></div>
      <div class="lb__info">
        <p class="lb__k mono"><span data-lb-count></span><span data-lb-format></span><span data-lb-year></span></p>
        <h2 id="lb-title" class="lb__title" data-lb-title></h2>
        <p class="lb__set mono" data-lb-set hidden></p>
        <div class="lb__note" data-lb-note hidden>
          <p class="mono">why it matters to me</p>
          <p data-lb-note-text></p>
        </div>
        <div class="lb__nav">
          <button type="button" data-lb-step="-1" aria-label="Previous title">←</button>
          <button type="button" data-lb-step="1" aria-label="Next title">→</button>
          <button type="button" class="lb__close" data-lb-close>close <kbd>esc</kbd></button>
        </div>
      </div>
    </div>
  </dialog>
</Play>

<script>
  const cinema = document.querySelector<HTMLElement>('[data-cinema]');
  if (cinema) {
    const screen = cinema.querySelector<HTMLElement>('[data-screen]')!;
    const strip = cinema.querySelector<HTMLElement>('[data-strip]')!;
    const frames = [...cinema.querySelectorAll<HTMLButtonElement>('[data-frame]')];
    const shows = new Map([...cinema.querySelectorAll<HTMLElement>('[data-show]')].map((el) => [el.dataset.show!, el]));
    const counter = cinema.querySelector<HTMLElement>('[data-counter]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const two = (n: number) => String(n).padStart(2, '0');

    let current = frames[0]?.dataset.frame ?? '';
    let cutting = 0;
    const onReel = () => frames.filter((f) => !f.hidden);

    const show = (id: string) => {
      for (const [key, el] of shows) el.hidden = key !== id;
      for (const f of frames) {
        const on = f.dataset.frame === id;
        f.setAttribute('aria-selected', String(on));
        f.tabIndex = on ? 0 : -1;
      }
      const reel = onReel();
      const at = reel.findIndex((f) => f.dataset.frame === id);
      if (counter) counter.textContent = `${two(at + 1)} / ${two(reel.length)}`;
      const frame = frames.find((f) => f.dataset.frame === id);
      // bring the frame to the middle of the strip without moving the page
      if (frame) strip.scrollTo({ left: frame.offsetLeft - (strip.clientWidth - frame.offsetWidth) / 2, behavior: reduce.matches ? 'auto' : 'smooth' });
    };

    /** cut to another title: the bars close, the screen changes behind them, they open */
    const cutTo = (id: string, quick = false) => {
      if (!shows.has(id) || id === current) return;
      current = id;
      try {
        history.replaceState(history.state, '', `#${id}`);
      } catch {}
      clearTimeout(cutting);
      if (quick || reduce.matches || document.querySelector<HTMLDialogElement>('[data-lightbox]')?.open) return show(id);
      screen.classList.remove('is-cutting');
      void screen.offsetWidth;
      screen.classList.add('is-cutting');
      cutting = window.setTimeout(() => show(id), 170);
      window.setTimeout(() => screen.classList.remove('is-cutting'), 620);
    };

    const step = (by: number) => {
      const reel = onReel();
      if (!reel.length) return;
      const at = reel.findIndex((f) => f.dataset.frame === current);
      const next = reel[(at + by + reel.length) % reel.length];
      cutTo(next.dataset.frame!);
      return next;
    };

    // a frame cuts to its title; the frame already showing opens it up close
    frames.forEach((f) => f.addEventListener('click', () => (f.dataset.frame === current ? openBox(current, f) : cutTo(f.dataset.frame!))));
    cinema.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((b) => b.addEventListener('click', () => cutTo(b.dataset.goto!)));
    cinema.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => step(Number(b.dataset.step))));

    // the strip is one tab stop; the arrows walk it
    strip.addEventListener('keydown', (e) => {
      const reel = onReel();
      let next: HTMLButtonElement | undefined;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = step(1);
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = step(-1);
      else if (e.key === 'Home') next = reel[0];
      else if (e.key === 'End') next = reel[reel.length - 1];
      else return;
      e.preventDefault();
      if (next) {
        cutTo(next.dataset.frame!);
        next.focus({ preventScroll: true });
      }
    });

    // a mouse wheel over the strip runs the film sideways
    strip.addEventListener(
      'wheel',
      (e) => {
        if (Math.abs(e.deltaY) <= Math.abs(e.deltaX) || strip.scrollWidth <= strip.clientWidth) return;
        const end = e.deltaY > 0 ? strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 1 : strip.scrollLeft <= 0;
        if (end) return; // at either end the page scrolls on as usual
        e.preventDefault();
        strip.scrollLeft += e.deltaY;
      },
      { passive: false },
    );

    // ── re-cutting the reel ──
    const cuts = [...cinema.querySelectorAll<HTMLButtonElement>('[data-cut]')];
    cuts.forEach((b) =>
      b.addEventListener('click', () => {
        const [kind, value] = b.dataset.cut!.split(':');
        cuts.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        for (const f of frames) {
          f.hidden = kind === 'shelf' ? !f.dataset.shelves!.split(' ').includes(value) : kind === 'type' ? f.dataset.type !== value : false;
        }
        const reel = onReel();
        if (!reel.some((f) => f.dataset.frame === current) && reel[0]) cutTo(reel[0].dataset.frame!);
        else show(current);
      }),
    );

    // ── the detail view ──
    const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const part = (name: string) => box?.querySelector<HTMLElement>(`[data-lb-${name}]`) ?? null;
    let opener: HTMLElement | null = null;

    const fillBox = (id: string) => {
      const el = shows.get(id);
      const frame = frames.find((f) => f.dataset.frame === id);
      if (!box || !el || !frame) return;
      const reel = onReel();
      const text = (name: string, value?: string | null) => {
        const node = part(name);
        if (node) node.textContent = value ?? '';
      };
      text('count', `${two(reel.indexOf(frame) + 1)} / ${two(reel.length)}`);
      text('format', frame.dataset.format);
      text('year', frame.dataset.year);
      text('title', el.querySelector('[data-show-title]')?.textContent);
      const set = part('set');
      if (set) {
        set.textContent = frame.dataset.setLine ?? '';
        set.hidden = !frame.dataset.setLine;
      }
      // the note shows only when one has been written
      const note = el.querySelector('[data-show-note] p:last-child')?.textContent?.trim();
      const noteBox = part('note');
      if (noteBox) noteBox.hidden = !note;
      text('note-text', note);
      // the artwork: a copy of the card on the screen, with whatever loaded (or failed) there
      const art = part('art');
      const card = el.querySelector<HTMLElement>('[data-card]');
      const poster = el.querySelector<HTMLElement>('[data-open]');
      if (art && card && poster) {
        art.style.cssText = poster.style.cssText;
        const copy = card.cloneNode(true) as HTMLElement;
        copy.querySelectorAll('img').forEach((img) => img.setAttribute('loading', 'eager'));
        art.replaceChildren(copy);
      }
    };

    function openBox(id: string, from: HTMLElement) {
      if (!box) return;
      opener = from;
      fillBox(id);
      box.showModal();
    }

    cinema.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) => b.addEventListener('click', () => openBox(b.dataset.open!, b)));
    box?.querySelector('[data-lb-close]')?.addEventListener('click', () => box.close());
    box?.addEventListener('click', (e) => e.target === box && box.close());
    // Escape closes it (the dialog does that itself); either way focus goes back to where it came from
    box?.addEventListener('close', () => {
      const back = opener?.offsetParent ? opener : cinema.querySelector<HTMLElement>(`[data-open="${current}"]`);
      back?.focus({ preventScroll: true });
    });
    const boxStep = (by: number) => {
      const next = step(by);
      if (next) fillBox(next.dataset.frame!);
    };
    box?.querySelectorAll<HTMLButtonElement>('[data-lb-step]').forEach((b) => b.addEventListener('click', () => boxStep(Number(b.dataset.lbStep))));
    box?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') boxStep(1);
      else if (e.key === 'ArrowLeft') boxStep(-1);
    });

    // a link straight to one title starts on it
    const wanted = decodeURIComponent(location.hash.slice(1));
    if (wanted && shows.has(wanted)) cutTo(wanted, true);
  }
</script>

<style>
  /* ── the room: lights down ──────────── */
  .cinema {
    --bg: #05060f;
    --fg: #f3f3ef;
    --fg-2: #a9abc6;
    --line: rgb(243 243 239 / 0.2);
    --accent: var(--room-films);
    --on-accent: #0c0d21;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--bar));
    background: var(--bg);
    color: var(--fg);
    overflow: clip;
  }

  .cinema__top {
    padding: clamp(18px, 2.4vw, 34px) var(--gutter) 0;
  }

  /* ── the screen ─────────────────────── */
  .screen {
    position: relative;
    display: grid;
    flex: 1;
    align-items: center;
    padding: clamp(14px, 2.6svh, 44px) var(--gutter) clamp(14px, 2.4svh, 38px);
    isolation: isolate;
  }

  /* the projector's light: a soft pool behind whatever is showing */
  .screen::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(60% 70% at 26% 50%, rgb(243 243 239 / 0.09), transparent 70%);
    pointer-events: none;
  }

  .show {
    display: grid;
    grid-template-columns: minmax(0, 0.4fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 5vw, 90px);
    max-width: var(--wrap);
    margin: 0 auto;
    width: 100%;
  }

  .show[hidden] {
    display: none;
  }

  /* without scripts there is no strip to choose from: show every title, one under another */
  :global(html:not(.js)) .show[hidden] {
    display: grid;
    margin-top: 60px;
  }

  .show__poster {
    position: relative;
    display: block;
    justify-self: end;
    width: min(100%, calc((100svh - var(--bar) - 424px) * 0.6667), 380px);
    min-width: 170px;
    aspect-ratio: 2 / 3;
    padding: 0;
    border: 0;
    background: var(--pbg);
    color: var(--pfg);
    font: inherit;
    text-align: left;
    cursor: zoom-in;
    transition:
      rotate 0.5s var(--spring),
      scale 0.4s var(--ease-out);
    box-shadow:
      0 0 0 1px rgb(243 243 239 / 0.16),
      0 40px 80px -30px rgb(0 0 0 / 0.9),
      0 0 120px -20px color-mix(in srgb, var(--pbg) 45%, transparent);
    rotate: -2.2deg;
    container-type: size;
  }

  .show__poster:hover {
    rotate: 0deg;
    scale: 1.02;
  }

  .show__poster:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 5px;
    box-shadow: none;
  }

  /* A poster made of type. It is under every piece of artwork, so a title is never a
     blank box: with no image, or if one fails to load, this is what shows. */
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    padding: 7cqw;
  }

  /* a real poster lies over the card, whole: never stretched, never cropped */
  .card__poster {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    background: #05060f;
    object-fit: contain;
  }

  /* a title card (wide) is set into the card, whole, above the title in type */
  .card--titlecard {
    grid-template-rows: auto 1fr auto auto;
  }

  .card__logo {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 5cqw 0;
  }

  .card__logo img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    min-height: 0;
    object-fit: contain;
  }

  .card--titlecard .card__title {
    font-size: clamp(15px, 10cqw, 44px);
  }

  .card__k,
  .card__foot {
    display: flex;
    justify-content: space-between;
    font: 500 clamp(9px, 4cqw, 13px) / 1.2 var(--font-mono);
  }

  .card__title {
    align-self: end;
    padding-bottom: 6cqw;
    font: 400 clamp(26px, 21cqw, 110px) / 0.92 var(--font-display);
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .card__foot {
    padding-top: 4cqw;
    border-top: 1.5px solid currentColor;
  }

  .show__k {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0;
    color: var(--fg-2);
  }

  .show__frame {
    color: var(--accent);
  }

  .show__title {
    max-width: 12ch;
    margin: clamp(8px, 1.2svh, 20px) 0 0;
    font: 400 clamp(48px, min(8.6vw, 11.6svh), 148px) / 0.92 var(--font-display);
    letter-spacing: 0.004em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .show__line {
    max-width: 24ch;
    margin: clamp(10px, 1.6svh, 26px) 0 0;
    font-size: clamp(20px, min(2.3vw, 3.5svh), 36px);
    line-height: 1.14;
  }

  .show__thoughts {
    max-width: 56ch;
    margin-top: clamp(12px, 1.8svh, 28px);
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .show__label {
    margin: 0 0 8px;
    color: var(--accent);
  }

  .show__thoughts p:not(.show__label) {
    margin: 0 0 0.8em;
    color: #dcdcd4;
    font-size: var(--fs-read);
    line-height: 1.62;
  }

  .show__shelves {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: clamp(10px, 1.4vw, 18px) 0 0;
  }

