DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio
ENVIRONMENT=development
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Your numeric GitHub user ID, not your username. No owner is accepted until set.
OWNER_GITHUB_ID=0
# Public repository picker; must resolve to OWNER_GITHUB_ID.
GITHUB_OWNER_LOGIN=
BACKEND_ORIGIN=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:4321
GITHUB_WEBHOOK_SECRET=
# Optional AI configuration. Choose openai or azure; incomplete configuration disables generation.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
# For Azure: set AI_PROVIDER=azure and all three values below.
# Resource endpoint, e.g. https://your-resource.openai.azure.com (no deployment path).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The deployment's name in Foundry, which can differ from the underlying model name.
AZURE_OPENAI_DEPLOYMENT=


# Deployment: worker uses a separate restricted database login.
PROCESS_ROLE=api
WORKER_DATABASE_URL=
WORKER_POLL_SECONDS=15
# Enable on the API only after the worker has its secret deploy hook configured.
REBUILD_ON_PUBLISH=false
VERCEL_DEPLOY_HOOK=

# Vercel event-driven jobs; local CLI worker remains supported.
QUEUE_ENABLED=false
CRON_SECRET=

# Explicit owner consent to send selected public repository SOURCE to the configured AI.
# Numeric GitHub IDs, comma-separated; empty disables full repository scans.
GITHUB_SCAN_REPOSITORIES=
